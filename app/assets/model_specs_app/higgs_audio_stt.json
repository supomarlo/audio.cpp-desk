        "required": false
      },
      {
        "name": "max_tokens",
        "type": "int",
        "description": "Maximum generated transcript tokens; default 1024.",
        "required": false,
        "min": 1,
        "default": 1024
      },
      {
        "name": "enable_thinking",
        "type": "bool",
        "description": "Enable the model thinking prompt; default true.",
        "required": false,
        "default": true
