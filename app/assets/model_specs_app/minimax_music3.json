  "i18n": {
    "description": {
      "en": "MiniMax Music 3 text-to-music generation with lyrics conditioning.",
      "zh": "MiniMax Music 3 文本生音乐，支持歌词条件。"
    },
    "options": {
      "lyrics": {
        "en": "Lyrics to sing. Structure tags such as [verse] and [chorus] are supported.",
        "zh": "要演唱的歌词。支持 [verse]、[chorus] 等结构标签。"
      },
      "duration_sec": {
        "en": "Maximum generated audio duration in seconds.",
        "zh": "生成音频的最大时长（秒）。"
      },
      "num_inference_steps": {
        "en": "Flow matching Euler steps per chunk.",
        "zh": "每个分块的流匹配 Euler 步数。"
      },
      "guidance_scale": {
        "en": "Flow transformer classifier-free guidance scale.",
        "zh": "Flow transformer 的无分类器引导强度。"
      },
      "ar_guidance_scale": {
        "en": "Autoregressive semantic and depth CFG scale.",
        "zh": "自回归语义与 depth 的 CFG 强度。"
      },
      "top_k": {
        "en": "Top-k sampling for semantic and residual code sampling.",
        "zh": "语义与残差码采样所用的 top-k。"
      },
      "seed": {
        "en": "Generation seed.",
        "zh": "生成随机种子。"
      },
      "ensemble_takes": {
        "en": "Decode N independent takes of the same prompt in one batched AR pass (seeds seed..seed+N-1); flow and vocoder run per take. Outputs are returned as named audio (take_01..take_NN) for --out-dir.",
        "zh": "在一次批处理自回归中解码同一提示的 N 个独立 take（种子为 seed..seed+N-1）；flow 与声码器按 take 分别运行。结果以命名音频（take_01..take_NN）输出到 --out-dir。"
      },
      "ensemble_prefix_frames": {
        "en": "Intro-lock for ensembles: decode the first N frames once as a shared master trajectory (~25 frames per second), then fork the takes (take_01 continues the master exactly). 0 disables.",
        "zh": "集成的前奏锁定：先把前 N 帧解码为共享主轨迹（约每秒 25 帧），再分叉各 take（take_01 精确延续主轨迹）。0 表示关闭。"
      },
      "flow_chunk_hop_frames": {
        "en": "Flow chunk hop in AR frames (~25/sec). Default 0 keeps the model config (100, 50% chunk overlap). 150 measures flow ~-35% with consistently rederived crops/carry.",
        "zh": "以自回归帧计（约每秒 25 帧）的 flow 分块跳步。默认 0 保持模型配置（100，50% 分块重叠）。取 150 时实测 flow 约快 35%，且裁剪/携带会持续重算。"
      }
    }
  }
}
