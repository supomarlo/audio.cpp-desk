{
  "family": "xtts_v2",
  "i18n": {
    "description": {
      "en": "Coqui XTTS v2 cross-lingual text-to-speech with voice cloning: GPT-2 mel-code generator, perceiver conditioning resampler, HiFi-GAN decoder, and speaker encoder.",
      "zh": "Coqui XTTS v2 跨语言文本转语音与音色克隆：GPT-2 mel-code 生成器、perceiver 条件重采样器、HiFi-GAN 解码器与说话人编码器。"
    },
    "options": {
      "language": {
        "en": "Source language for text conditioning (e.g. 'en'); also selects tokenizer normalization.",
        "zh": "文本条件的源语言（如 'en'）；同时选择 tokenizer 归一化。"
      },
      "temperature": {
        "en": "AR sampling temperature; official default 0.75.",
        "zh": "AR 采样温度；官方默认 0.75。"
      },
      "top_k": {
        "en": "AR top-k sampling; official default 50.",
        "zh": "AR top-k 采样；官方默认 50。"
      },
      "top_p": {
        "en": "AR nucleus sampling threshold; official default 0.85.",
        "zh": "AR 核采样阈值；官方默认 0.85。"
      },
      "repetition_penalty": {
        "en": "AR repetition penalty; official default 10.0.",
        "zh": "AR 重复惩罚；官方默认 10.0。"
      },
      "max_mel_tokens": {
        "en": "Maximum mel codes to generate; official default 605.",
        "zh": "生成的最大 mel code 数；官方默认 605。"
      },
      "seed": {
        "en": "Sampling seed; omitted selects a random seed.",
        "zh": "采样随机种子；省略时随机选择。"
      },
      "text_chunk_size": {
        "en": "Maximum Unicode codepoints per framework text chunk; default 256.",
        "zh": "框架文本分块的最大 Unicode 码点数；默认 256。"
      },
      "text_chunk_mode": {
        "en": "Framework text chunking mode.",
        "zh": "框架文本分块模式。"
      }
    }
  },
