{
  "family": "omnivoice",
  "i18n": {
    "description": {
      "en": "Massively multilingual zero-shot TTS model from k2-fsa for 600+ languages, supporting short-reference voice cloning, attribute-based voice design, pronunciation controls, and nonverbal tags.",
      "zh": "k2-fsa 的大规模多语言零样本 TTS 模型，覆盖 600 多种语言，支持短参考音色克隆、基于属性的音色设计、发音控制和非语言标签。"
    },
    "options": {
      "speed": {
        "en": "Speech rate multiplier, adjusting the overall speed of the generated speech",
        "zh": "语速倍率，调整生成语音的整体速度"
      },
      "guidance_scale": {
        "en": "Guidance scale, adjusting how closely the generated speech follows the prompt",
        "zh": "引导系数，调整生成语音与提示条件的贴合程度"
      },
      "num_inference_steps": {
        "en": "Diffusion inference steps; higher values usually improve quality but take longer",
        "zh": "扩散推理步数，越大通常质量更好、耗时更长"
      },
      "seed": {
        "en": "Random seed; a fixed value makes results reproducible, and leaving it empty picks a random seed",
        "zh": "随机种子，固定后可复现，留空随机"
      },
      "language": {
        "en": "Synthesis language; leave empty for automatic detection",
        "zh": "合成语言，留空自动判断"
      },
      "reference_text": {
        "en": "Text corresponding to the reference voice audio",
        "zh": "音色参考音频对应的文本"
      },
      "instruct": {
        "en": "Voice-design instruction describing speaker, accent, style, or delivery",
        "zh": "音色设计指令，描述说话人、口音、风格或表达方式"
      },
      "duration_sec": {
        "en": "Target audio duration in seconds; leave empty to use the model estimate",
        "zh": "目标音频时长（秒），留空由模型估算"
      },
      "shift": {
        "en": "Diffusion timestep schedule shift",
        "zh": "扩散时间步调度偏移"
      },
      "denoise": {
        "en": "Enable denoise control; active after selecting a voice",
        "zh": "启用去噪控制，选择音色后生效"
      },
      "preprocess_prompt": {
        "en": "Preprocess the reference audio before tokenization; active after selecting a voice",
        "zh": "在分词前预处理参考音频，选择音色后生效"
      },
      "postprocess_output": {
        "en": "Apply output postprocessing and trimming",
        "zh": "对输出进行后处理与裁剪"
      },
      "layer_penalty_factor": {
        "en": "Layer-order penalty for audio codebook position selection",
        "zh": "选择音频码本位置时的层序惩罚"
      },
      "position_temperature": {
        "en": "Gumbel temperature for masked-position selection",
        "zh": "选择遮罩位置时的 Gumbel 温度"
      },
      "class_temperature": {
        "en": "Audio-token class sampling temperature; 0 selects greedily",
        "zh": "音频 token 类别采样温度，0 时按贪心方式选择类别"
      },
      "audio_chunk_duration_sec": {
        "en": "Target duration for automatic long-audio segmentation (seconds)",
        "zh": "长音频自动分段的目标时长（秒）"
      },
      "audio_chunk_threshold_sec": {
        "en": "Enable long-audio segmentation when the estimated duration exceeds this value (seconds)",
        "zh": "估算时长超过该值（秒）时启用长音频分段"
      },
      "text_chunk_size": {
        "en": "Maximum characters per long-text segment; leave empty to segment automatically by duration",
        "zh": "长文本分段的最大字符数，留空按时长自动分段"
      },
      "text_chunk_mode": {
        "en": "Long-text segmentation mode",
        "zh": "长文本分段方式"
      }
    },
    "ui": {
      "language.auto": {
        "en": "Auto",
        "zh": "自动"
      },
      "textChunkMode.default": {
        "en": "Default",
        "zh": "默认"
      },
      "textChunkMode.tag_aware": {
        "en": "Preserve tags",
        "zh": "保留标签"
      },
      "textChunkMode.japanese": {
        "en": "Japanese-aware",
        "zh": "适配日文"
      },
      "textChunkMode.endline": {
        "en": "Line-end sentence split",
        "zh": "行尾句末分段"
      },
      "speed.ignoredByDuration": {
        "en": "When target duration is set, it takes priority",
        "zh": "目标时长非空时，优先使用目标时长"
      },
      "textChunkMode.requiresChunkSize": {
        "en": "Please set a segment size first",
        "zh": "请先设置分段大小"
      },
      "audioChunk.ignoredByTextChunk": {
        "en": "Segmentation is controlled by text segment size",
        "zh": "当前由文本分段控制"
      },
      "northeasternRequiresNewerServer": {
        "en": "Requires audio.cpp newer than 0.9.3",
        "zh": "需要 audio.cpp 版本高于 0.9.3"
      }
    }
  },
