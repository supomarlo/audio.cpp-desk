{
  "family": "miotts",
  "i18n": {
    "description": {
      "en": "Lightweight LLM-based English and Japanese TTS family built on MioCodec, supporting low-latency speech generation and zero-shot voice cloning from short reference audio.",
      "zh": "基于 MioCodec 的轻量 LLM 英语/日语 TTS 家族，支持低延迟语音生成与从短参考音频的零样本音色克隆。"
    },
    "options": {
      "temperature": {
        "en": "Generation control; defaults to the checkpoint config.",
        "zh": "发电控制；默认为检查点配置。"
      },
      "top_k": {
        "en": "Generation control; defaults to the checkpoint config.",
        "zh": "发电控制；默认为检查点配置。"
      },
      "top_p": {
        "en": "Generation control; defaults to the checkpoint config.",
        "zh": "发电控制；默认为检查点配置。"
      },
      "repetition_penalty": {
        "en": "Generation control; defaults to the checkpoint config.",
        "zh": "发电控制；默认为检查点配置。"
      },
      "frequency_penalty": {
        "en": "Frequency penalty; default 0.",
        "zh": "频率惩罚；默认 0。"
      },
      "presence_penalty": {
        "en": "Presence penalty; default 0.",
        "zh": "出庭处罚；默认 0。"
      },
      "seed": {
        "en": "Sampling seed; omitted chooses a random seed.",
        "zh": "种子取样；省略选择随机种子。"
      },
      "max_tokens": {
        "en": "Maximum generated tokens; default 700.",
        "zh": "最大生成代币；默认 700。"
      },
      "do_sample": {
        "en": "Generation control; defaults to the checkpoint config.",
        "zh": "生成控制；默认使用检查点配置。"
      },
      "best_of_n": {
        "en": "Candidate count, capped by the session maximum; greater than one enables best-of-N.",
        "zh": "候选数量，受会话上限限制；大于 1 启用 best-of-N。"
      },
      "best_of_n_enabled": {
        "en": "Override the session best-of-N setting.",
        "zh": "覆盖会话的 best-of-N 设置。"
      },
      "best_of_n_language": {
        "en": "ASR language used to rank candidates.",
        "zh": "用于候选排序的 ASR 语言。"
      },
      "text_chunk_size": {
        "en": "Framework long-form text chunk size; inherits the session setting.",
        "zh": "框架长文本分块大小；继承会话设置。"
      }
    }
  },
