      },
      {
        "name": "presence_penalty",
        "type": "float",
        "description": "Presence penalty."
      },
      {
        "name": "seed",
        "type": "int",
        "description": "Sampling seed; random if omitted."
      },
      {
        "name": "max_tokens",
        "type": "int",
        "description": "Maximum generated tokens."
      }
