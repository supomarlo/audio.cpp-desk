{
  "family": "index_tts2",
  "display_name": "IndexTTS2",
  "description": "Zero-shot TTS system with voice cloning, emotion-speaker decoupling, text or audio emotion control, and explicit duration control. Variant v2 covers Chinese and English; variant v2.5 (config version 2.5) adds multilingual tiktoken tokenization with Japanese, Spanish and Arabic support.",
  "category": "tts",
  "status": "supported",
  "tasks": [
    "tts",
    "clone"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "zh",
    "en",
    "ja",
    "es",
    "ar"
  ],
  "capabilities": {
    "tts": [
      "emotion_control"
    ],
    "clone": [
      "speaker_reference",
      "emotion_control"
    ]
  },
  "options": {
    "request": [
      {
        "name": "emotion_alpha",
        "type": "float",
        "description": "Blend strength for explicit emotion conditioning.",
        "required": false,
        "min": 0.0,
        "max": 1.0,
        "default": 1.0
      },
      {
        "name": "emotion_vector",
        "type": "string",
        "description": "Eight-value explicit emotion vector.",
        "required": false
      },
      {
        "name": "emotion_text",
        "type": "string",
        "description": "Text used when emotion-text conditioning is enabled.",
        "required": false
      },
      {
        "name": "interval_silence_ms",
        "type": "int",
        "description": "Silence inserted between generated text chunks.",
        "required": false,
        "min": 0,
        "default": 200
      },
      {
        "name": "duration_factor",
        "type": "float",
        "description": "Output duration multiplier for speech-rate control; >1 slower, <1 faster. Matches official IndexTTS2.5 duration_factor.",
        "required": false,
        "min": 0.0,
        "default": 1.0
      },
      {
        "name": "language",
        "type": "enum",
        "description": "Text language hint; auto infers zh when the text contains Han characters, otherwise en.",
        "values": [
          "auto",
          "zh",
          "en",
          "ja",
          "es",
          "ar"
        ],
        "required": false,
        "default": "auto"
      },
      {
        "name": "temperature",
        "type": "float",
        "description": "Sampling temperature.",
        "default": 0.8
      },
      {
        "name": "top_k",
        "type": "int",
        "description": "Top-k sampling limit.",
        "default": 30
      },
      {
        "name": "top_p",
        "type": "float",
        "description": "Nucleus sampling probability.",
        "default": 0.8
      },
      {
        "name": "repetition_penalty",
        "type": "float",
        "description": "Repetition penalty.",
        "default": 10.0
      },
      {
        "name": "seed",
        "type": "int",
        "description": "Sampling seed; random if omitted."
      },
      {
        "name": "max_tokens",
        "type": "int",
        "description": "Maximum generated tokens.",
        "default": 1500
      }
    ]
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "ui": {
    "recommended_package": "index_tts2_q8_0",
    "tags": [
      "TTS",
      "Clone",
      "GGUF"
    ],
    "docs": [
      "docs/tts.md",
      "docs/gguf.md"
    ]
  },
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "audio-cpp/audio.cpp-gguf",
      "revision": "main",
      "gated": false
    }
  },
  "sources": [
    {
      "format": "gguf",
      "roots": {
