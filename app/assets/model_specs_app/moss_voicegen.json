{
  "family": "moss_voicegen",
  "display_name": "MOSS-VoiceGenerator",
  "description": "MOSS voice design model: creates a speaker from a written instruction instead of a reference recording, then speaks the supplied text in that voice.",
  "category": "community",
  "status": "community",
  "tasks": [
    "design"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "en",
    "zh"
  ],
  "capabilities": {
    "vdes": [
      "style_condition"
    ]
  },
  "options": {
    "request": [
      {
        "name": "instruct",
        "type": "string",
        "description": "Voice description: timbre, age, pace, emotion."
      },
      {
        "name": "language",
        "type": "enum",
        "description": "Full language name; the model does not understand codes like 'en'.",
        "values": [
          "English",
          "Chinese"
        ]
      },
      {
        "name": "seed",
        "type": "int",
        "description": "Reproduces a take exactly. Note that it does not carry a voice across different text."
      },
      {
        "name": "temperature",
        "type": "float",
        "description": "Audio sampling temperature (default 1.5)."
      },
      {
        "name": "top_p",
        "type": "float",
        "description": "Audio nucleus sampling cutoff (default 0.6)."
      },
      {
        "name": "top_k",
        "type": "int",
        "description": "Audio top-k (default 50)."
      },
      {
        "name": "repetition_penalty",
        "type": "float",
        "description": "Audio repetition penalty (default 1.1)."
      }
    ]
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "ui": {
    "recommended_package": "moss_voicegen_bf16_codec_f16_decode",
