  "i18n": {
    "description": {
      "en": "YuE2 music generation model with symbolic ABC planning, semantic codec generation, NAR acoustic flow synthesis, and Oobleck VAE decode.",
      "zh": "YuE2 音乐生成模型，含符号 ABC 规划、语义编解码生成、NAR 声学流合成与 Oobleck VAE 解码。"
    },
    "options": {
      "style": {
        "en": "Song style/tags.",
        "zh": "歌曲风格/标签。"
      },
      "lyrics": {
        "en": "Lyrics text. If omitted, the CLI text input is used.",
        "zh": "歌词文本。省略时使用 CLI 的文本输入。"
      },
      "cot": {
        "en": "Symbolic planning route. off skips ABC generation; melody/full generate or consume ABC before music tokens.",
        "zh": "符号规划路线。off 跳过 ABC 生成；melody/full 会在音乐 token 之前生成或使用 ABC。"
      },
      "stop_after": {
        "en": "Last stage to run. abc writes the generated score only; semantic also writes the semantic token export; audio renders the full song.",
        "zh": "运行到哪个阶段为止。abc 仅写出生成的乐谱；semantic 还写出语义 token 导出；audio 渲染完整歌曲。"
      },
      "abc": {
        "en": "External ABC score text for melody/full routes.",
        "zh": "melody/full 路线使用的外部 ABC 乐谱文本。"
      },
      "abc_file": {
        "en": "Path to an external ABC score file for melody/full routes.",
        "zh": "melody/full 路线使用的外部 ABC 乐谱文件路径。"
      },
      "export_semantic": {
        "en": "Attach the semantic token stream as a semantic artifact (JSON array of codec indices); default false.",
        "zh": "把语义 token 流作为语义产物附带输出（编解码索引的 JSON 数组）；默认 false。"
      },
      "guidance_scale": {
        "en": "Semantic classifier-free guidance scale. Default follows the upstream route defaults.",
        "zh": "语义无分类器引导强度。默认跟随上游各路线的默认值。"
      },
      "seed": {
        "en": "Generation seed.",
        "zh": "生成随机种子。"
      },
      "num_inference_steps": {
        "en": "NAR midpoint ODE steps.",
        "zh": "NAR 中点 ODE 步数。"
      }
    }
  }
}
