{
  "family": "yue2",
  "i18n": {
    "description": {
      "en": "YuE2 music generation model with symbolic ABC planning, semantic codec generation, NAR acoustic flow synthesis, and Oobleck VAE decode.",
      "zh": "YuE2 音乐生成模型，含符号 ABC 规划、语义编解码生成、NAR 声学流合成与 Oobleck VAE 解码。"
    },
    "options": {
      "style": {
        "en": "Song style/tags.",
        "zh": "歌曲风格/标签。"
      },
      "lyrics": {
        "en": "Lyrics text. Leave empty for instrumental generation; if omitted, the CLI text input is used.",
        "zh": "歌词文本。为工具生成留空；如果省略，则使用 CLI 文本输入。"
      },
      "cot": {
        "en": "Symbolic planning route. off skips ABC generation; melody/full generate or consume ABC before music tokens.",
        "zh": "符号规划路线。off 跳过 ABC 生成；melody/full 会在音乐 token 之前生成或使用 ABC。"
      },
      "stop_after": {
        "en": "Last stage to run. abc writes the generated score only; semantic also writes the semantic token export; audio renders the full song.",
        "zh": "运行到哪个阶段为止。abc 仅写出生成的乐谱；semantic 还写出语义 token 导出；audio 渲染完整歌曲。"
      },
      "abc": {
        "en": "External ABC score text for melody/full routes.",
        "zh": "melody/full 路线使用的外部 ABC 乐谱文本。"
      },
      "abc_file": {
        "en": "Path to an external ABC score file for melody/full routes.",
        "zh": "melody/full 路线使用的外部 ABC 乐谱文件路径。"
      },
      "export_semantic": {
        "en": "Attach the semantic token stream as a semantic artifact (JSON array of codec indices); default false.",
        "zh": "把语义 token 流作为语义产物附带输出（编解码索引的 JSON 数组）；默认 false。"
      },
      "guidance_scale": {
        "en": "Semantic classifier-free guidance scale. Default follows the upstream route defaults. Omitted defaults to 1.01 with cot=off, otherwise 1.0.",
        "zh": "无语义分类器指导量表。默认值遵循上游路由默认值。当 cot=off 时，忽略默认为 1.01，否则为 1.0。"
      },
      "seed": {
        "en": "Generation seed. Must be nonnegative and less than 2^63.",
        "zh": "世代种子。必须为非负且小于 2^63。"
      },
      "num_inference_steps": {
        "en": "NAR midpoint ODE steps.",
        "zh": "NAR 中点 ODE 步数。"
      },
      "semantic_prefix": {
        "en": "JSON array of semantic codec indices to force as the start of the music stream.",
        "zh": "作为音乐流起始强制使用的语义 codec 索引 JSON 数组。"
      },
      "semantic_prefix_file": {
        "en": "Path to a JSON array of semantic codec indices to force as the start of the music stream.",
        "zh": "作为音乐流起始强制使用的语义 codec 索引 JSON 数组文件路径。"
      },
      "nar_noise_file": {
        "en": "Path to a raw float32 noise file for NAR generation, shaped [frames,64].",
        "zh": "NAR 生成的原始 float32 噪声文件路径，形状 [frames,64]。"
      },
      "abc_temperature": {
        "en": "ABC planner sampling temperature.",
        "zh": "ABC 规划器采样温度。"
      },
      "abc_top_p": {
        "en": "ABC planner nucleus sampling probability. Must be in (0, 1].",
        "zh": "ABC 规划器核采样概率；必须在 (0,1]。"
      },
      "abc_top_k": {
        "en": "ABC planner top-k sampling limit.",
        "zh": "ABC 规划器 top-k 采样上限。"
      },
      "abc_repetition_penalty": {
        "en": "ABC planner repetition penalty. Must be positive.",
        "zh": "ABC 规划器重复惩罚；必须为正。"
      },
      "abc_penalty_window": {
        "en": "ABC planner repetition penalty window.",
        "zh": "ABC 规划器重复惩罚窗口。"
      },
      "abc_min_tokens": {
        "en": "Minimum ABC planner tokens before EOS is accepted.",
        "zh": "接受 EOS 前的最小 ABC 规划器 token 数。"
      },
      "abc_max_tokens": {
        "en": "Maximum ABC planner tokens. Zero is allowed when min_tokens is also zero.",
        "zh": "ABC 规划器最大 token 数；min_tokens 也为 0 时允许 0。"
      },
      "semantic_temperature": {
        "en": "Semantic codec sampling temperature.",
        "zh": "语义 codec 采样温度。"
      },
      "semantic_top_p": {
        "en": "Semantic codec nucleus sampling probability. Must be in (0, 1].",
        "zh": "语义 codec 核采样概率；必须在 (0,1]。"
      },
      "semantic_top_k": {
        "en": "Semantic codec top-k sampling limit.",
        "zh": "语义 codec top-k 采样上限。"
      },
      "semantic_repetition_penalty": {
        "en": "Semantic codec repetition penalty. Must be positive.",
        "zh": "语义 codec 重复惩罚；必须为正。"
      },
      "semantic_penalty_window": {
        "en": "Semantic codec repetition penalty window.",
        "zh": "语义 codec 重复惩罚窗口。"
      },
      "semantic_min_tokens": {
        "en": "Minimum semantic tokens before EOS is accepted.",
        "zh": "接受 EOS 前的最小语义 token 数。"
      },
      "semantic_max_tokens": {
        "en": "Maximum semantic codec tokens. Zero is allowed when min_tokens is also zero.",
        "zh": "语义 codec 最大 token 数；min_tokens 也为 0 时允许 0。"
      }
    }
  },
