{
  "family": "stable_audio",
  "i18n": {
    "description": {
      "en": "Stability AI generative audio model family for text-to-music, sound effects, audio-to-audio editing, inpainting, continuation, variable-length generation, and LoRA personalization.",
      "zh": "Stability AI 生成式音频模型家族，用于文本生音乐、音效、音频到音频编辑、音频修复、续写、可变长度生成与 LoRA 个性化。"
    },
    "options": {
      "num_inference_steps": {
        "en": "Diffusion steps.",
        "zh": "扩散步骤。"
      },
      "guidance_scale": {
        "en": "Classifier-free guidance scale.",
        "zh": "无分类器引导强度。"
      },
      "apg_scale": {
        "en": "Adaptive projected guidance scale.",
        "zh": "自适应投影引导（APG）强度。"
      },
      "negative_prompt": {
        "en": "Negative prompt; pipe separates batch prompts.",
        "zh": "负面提示；管道分隔批处理提示。"
      },
      "truncate_output_to_duration": {
        "en": "Trim decoded audio to requested duration.",
        "zh": "把解码音频裁剪到请求时长。"
      },
      "chunked_decode": {
        "en": "Decode audio in chunks.",
        "zh": "分块解码音频。"
      },
      "init_noise_level": {
        "en": "Audio-conditioned generation strength in [0, 1].",
        "zh": "[0, 1] 中的音频调节生成强度。"
      },
      "audio_input_kind": {
        "en": "How to use audio_input.",
        "zh": "如何使用音频输入。"
      },
      "seed": {
        "en": "Sampling seed; omitted chooses a random seed.",
        "zh": "种子取样；省略选择随机种子。"
      },
      "prompt": {
        "en": "Fallback text prompt when text_input is absent; pipe separates batch prompts.",
        "zh": "text_input 缺失时的回退文本提示；管道符分隔批量提示。"
      },
      "duration_sec": {
        "en": "Positive duration in seconds; batch requests also accept a comma-separated string matching the prompt count, not a JSON array.",
        "zh": "时长（秒），必须为正；批量请求也接受与提示数匹配的逗号分隔字符串，而不是 JSON 数组。"
      },
      "batch_size": {
        "en": "Prompt batch size.",
        "zh": "提示批大小。"
      },
      "sampler_mode": {
        "en": "Stable Audio 3 diffusion sampler.",
        "zh": "Stable Audio 3 扩散采样器。"
      },
      "duration_padding_sec": {
        "en": "Generated padding before truncation.",
        "zh": "截断前生成的填充时长。"
      },
      "inpaint_mask_start_sec": {
        "en": "Comma-separated inpaint region starts in seconds.",
        "zh": "逗号分隔的 inpaint 区域起始秒数。"
      },
      "inpaint_mask_end_sec": {
        "en": "Comma-separated inpaint region ends in seconds.",
        "zh": "逗号分隔的 inpaint 区域结束秒数。"
      }
    }
  },
