{
  "family": "qwen3_tts",
  "i18n": {
    "description": {
      "en": "Qwen3-TTS for controllable 10-language synthesis, 3-second voice cloning, CustomVoice, and VoiceDesign.",
      "zh": "Qwen3-TTS，支持 10 语言可控语音合成、3 秒音色克隆、CustomVoice 与 VoiceDesign。"
    },
    "ui": {
      "referenceText.hint": {
        "en": "Recommended: fill it in to improve clone similarity",
        "zh": "推荐填写，通常能提升克隆相似度"
      }
    },
    "options": {
      "temperature": {
        "en": "Sampling randomness for the main speech stream",
        "zh": "主语音流的采样随机性"
      },
      "top_k": {
        "en": "Top-k candidate count for the main speech stream",
        "zh": "主语音流的 Top-k 候选数量"
      },
      "top_p": {
        "en": "Top-p retention probability for the main speech stream",
        "zh": "主语音流的 Top-p 保留概率"
      },
      "repetition_penalty": {
        "en": "Repetition penalty for the main speech stream",
        "zh": "主语音流的重复惩罚"
      },
      "seed": {
        "en": "Random seed: a fixed value makes results reproducible; leave empty for random",
        "zh": "随机种子，固定后可复现，留空随机"
      },
      "max_tokens": {
        "en": "Maximum acoustic frames per text chunk; leave empty to use the model default",
        "zh": "每个文本分段的最大声学帧数，留空使用模型默认值"
      },
      "stream_chunk_policy": {
        "en": "Streaming codec chunk schedule: grow starts with one frame and doubles to stream_frames_per_event; fixed uses that size throughout",
        "zh": "流式 codec 分块策略：grow 从 1 帧开始逐步翻倍到 stream_frames_per_event；fixed 全程使用固定大小"
      },
      "stream_frames_per_event": {
        "en": "Codec frames per fixed streaming event, or the maximum for growing events. Smaller values reduce chunk latency but increase decoding overhead",
        "zh": "每个固定流式事件的 codec 帧数，或 grow 模式的最大帧数。较小值降低分块延迟但增加解码开销"
      },
      "language": {
        "en": "Target synthesis language code or label; default auto lets the model infer from text and voice settings",
        "zh": "目标合成语言代码或标签；默认 auto，由模型根据文本和音色设置推断"
      },
      "do_sample": {
        "en": "Enable sampling for the main speech stream; disable for deterministic decoding",
        "zh": "主语音流启用采样，关闭后使用确定性解码"
      },
      "subtalker_do_sample": {
        "en": "Enable sampling for the subtalker stream; disable for deterministic decoding",
        "zh": "子语音流启用采样，关闭后使用确定性解码"
      },
      "subtalker_temperature": {
        "en": "Sampling randomness for the subtalker stream",
        "zh": "子语音流的采样随机性"
      },
      "subtalker_top_k": {
        "en": "Top-k candidate count for the subtalker stream",
        "zh": "子语音流的 Top-k 候选数量"
      },
      "subtalker_top_p": {
        "en": "Top-p retention probability for the subtalker stream",
        "zh": "子语音流的 Top-p 保留概率"
      },
      "reference_text": {
        "en": "Transcript matching the reference audio for voice cloning; required unless x_vector_only_mode=true",
        "zh": "与参考音频匹配的转写文本，用于音色克隆；除非 x_vector_only_mode=true，否则必填"
      },
      "x_vector_only_mode": {
        "en": "Clone using only the reference speaker embedding; no reference transcript is needed",
        "zh": "仅用参考音频的音色特征克隆，不需要参考音频转写文本"
      },
      "instruct": {
        "en": "Optional natural-language voice or style instruction for VoiceDesign and CustomVoice variants; empty instructions are accepted",
        "zh": "VoiceDesign 与 CustomVoice 变体可选的音色/风格自然语言指令；允许空指令"
      },
      "voice_id": {
        "en": "Named preset speaker from the CustomVoice checkpoint. Legacy speaker remains accepted",
        "zh": "CustomVoice 检查点中的命名预置音色；仍接受旧 speaker 值",
