  "i18n": {
    "description": {
      "en": "Qwen TTS family for controllable 10-language speech synthesis, including 3-second voice cloning, CustomVoice instruction control over preset timbres, and VoiceDesign from natural-language descriptions.",
      "zh": "Qwen TTS 家族，面向可控的 10 语言语音合成，含 3 秒音色克隆、CustomVoice 对预设音色的指令控制，以及依据自然语言描述进行声音设计（VoiceDesign）。"
    },
    "options": {
      "temperature": {
        "en": "Main talker temperature; default 0.9.",
        "zh": "主 talker 采样温度；默认 0.9。"
      },
      "top_k": {
        "en": "Main talker top-k; default 50.",
        "zh": "主 talker 的 top-k；默认 50。"
      },
      "top_p": {
        "en": "Main talker top-p; default 1.0.",
        "zh": "主 talker 的 top-p；默认 1.0。"
      },
      "repetition_penalty": {
        "en": "Main talker repetition penalty; default 1.05.",
        "zh": "主 talker 重复惩罚；默认 1.05。"
      },
      "seed": {
        "en": "Sampling seed; random if omitted.",
        "zh": "采样随机种子；省略时随机。"
      },
      "max_tokens": {
        "en": "Maximum generated speech tokens per chunk; default 8192.",
        "zh": "每个分块最多生成的语音 token 数；默认 8192。"
      }
    }
  }
