{
  "schema_version": 1,
  "family": "sam_audio",
  "display_name": "SAM Audio",
  "description": "Prompt-conditioned audio separation.",
  "category": "audio_tools",
  "status": "supported",
  "tasks": [
    "s2s"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "language_agnostic"
  ],
  "capabilities": {},
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "options": {
    "request": [
      {
        "name": "reference_video_file",
        "type": "path",
        "description": "Masked video identifying the target source; frames are matched to audio by nearest timestamp. Requires libav runtime libraries. Mutually exclusive with reference_image_file.",
        "required": false
      },
      {
        "name": "reference_image_file",
        "type": "path",
        "description": "Masked RGB image identifying the target sound source, used as a constant visual prompt throughout the recording. Mask unwanted regions before supplying the image.",
        "required": false
      },
      {
        "name": "anchors",
        "type": "string",
        "description": "Optional JSON array of time spans: [[\"+\", start_seconds, end_seconds], [\"-\", start_seconds, end_seconds]]. Positive spans identify the target; negative spans identify sounds to exclude.",
        "required": false
      },
      {
        "name": "seed",
        "type": "int",
        "description": "Random seed; -1 selects a random seed.",
        "min": -1,
        "max": 4294967295,
        "default": 42,
        "required": false
      },
      {
        "name": "num_inference_steps",
        "type": "int",
        "description": "Midpoint integration steps; each step evaluates the denoiser twice.",
        "min": 1,
        "default": 16,
        "required": false
      }
    ],
    "session": [
      {
        "name": "memory_bounded",
        "type": "bool",
        "description": "Experimental bounded-workspace execution with full recording context. Provisional option name.",
        "default": false,
        "required": false
      }
    ],
    "load": []
  },
