{
  "family": "sam_audio",
  "i18n": {
    "description": {
      "en": "Prompt-conditioned audio separation.",
      "zh": "提示条件音频分离。"
    },
    "options": {
      "reference_video_file": {
        "en": "Masked video identifying the target source; frames are matched to audio by nearest timestamp. Requires libav runtime libraries. Mutually exclusive with reference_image_file.",
        "zh": "用于标识目标声源的遮罩视频；帧按最近时间戳与音频匹配。需要 libav 运行时库。与 reference_image_file 互斥。"
      },
      "reference_image_file": {
        "en": "Masked RGB image identifying the target sound source, used as a constant visual prompt throughout the recording. Mask unwanted regions before supplying the image.",
        "zh": "用于标识目标声源的遮罩 RGB 图像，在整个录音中作为恒定视觉提示。提供图像前请先遮掉不需要的区域。"
      },
      "anchors": {
        "en": "Optional JSON array of time spans: [[\"+\", start_seconds, end_seconds], [\"-\", start_seconds, end_seconds]]. Positive spans identify the target; negative spans identify sounds to exclude.",
        "zh": "可选的时间跨度 JSON 数组：[[\"+\", start_seconds, end_seconds], [\"-\", start_seconds, end_seconds]]。正跨度标识目标；负跨度标识要排除的声音。"
      },
      "seed": {
        "en": "Random seed; -1 selects a random seed.",
        "zh": "随机种子；-1 表示随机选择。"
      },
      "num_inference_steps": {
        "en": "Midpoint integration steps; each step evaluates the denoiser twice.",
        "zh": "中点积分步数；每步评估去噪器两次。"
      }
    }
  },
