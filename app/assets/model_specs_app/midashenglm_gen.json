  "i18n": {
    "description": {
      "en": "DashengLM generative audio model for speech, music, sound effects, and ambience prompts.",
      "zh": "DashengLM 生成式音频模型，面向语音、音乐、音效与环境声提示。"
    },
    "options": {
      "duration_sec": {
        "en": "Target audio duration budget; omitted derives from the checkpoint sequence length, hop size and sample rate. Must be finite and positive; no fixed runtime upper cap.",
        "zh": "目标音频持续时间预算；省略源自检查点序列长度、跳数大小和采样率。必须是有限且正的；没有固定的运行时间上限。"
      },
      "guidance_scale": {
        "en": "Classifier-free guidance scale. Any finite value is accepted.",
        "zh": "无分类器指导量表。接受任何有限值。"
      },
      "stop_threshold": {
        "en": "Stop probability threshold. Any finite value is accepted.",
        "zh": "停止概率阈值。接受任何有限值。"
      },
      "min_stop_step": {
        "en": "Minimum generated steps before accepting stop.",
        "zh": "接受停止前的最少生成步数。"
      },
      "seed": {
        "en": "Unsigned 32-bit generation seed; default 0 is a fixed seed. Negative values are not accepted.",
        "zh": "无符号 32 位生成种子；默认 0 是固定种子。不接受负值。"
      }
    }
  },
