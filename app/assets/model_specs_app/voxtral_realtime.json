{
  "family": "voxtral_realtime",
  "i18n": {
    "description": {
      "en": "Mistral 13-language realtime ASR model with a natively streaming causal audio encoder, configurable low-latency transcription delay, and accuracy competitive with offline open-source systems.",
      "zh": "Mistral 13 语言实时 ASR 模型，具备原生流式因果音频编码器、可配置低延迟转写时延，准确率可与离线开源系统竞争。"
    },
    "options": {
      "temperature": {
        "en": "Sampling temperature; must be > 0.",
        "zh": "采样温度；必须 > 0。"
      },
      "top_p": {
        "en": "Nucleus sampling probability in (0, 1].",
        "zh": "(0, 1] 中的核采样概率。"
      },
      "top_k": {
        "en": "Top-k sampling limit; zero disables filtering.",
        "zh": "Top-k采样限制；零禁用过滤。"
      },
      "seed": {
        "en": "Sampling seed.",
        "zh": "采样随机种子。"
      },
      "max_tokens": {
        "en": "Maximum generated transcript tokens; omitted uses the audio-derived limit. Offline decoding only; ignored by live streaming.",
        "zh": "最大转写 token 数；省略时使用按音频推导的限制。仅离线解码；实时流式忽略。"
      },
      "do_sample": {
        "en": "Sample rather than greedily decode.",
        "zh": "采样而非贪心解码。"
      }
    }
  },
