{
  "family": "kugelaudio",
  "i18n": {
    "description": {
      "en": "KugelAudio text-to-speech with bundled preset voices and incremental audio output.",
      "zh": "KugelAudio 文本转语音，内置预置音色并支持增量音频输出。"
    },
    "options": {
      "voice_id": {
        "en": "Bundled preset voice.",
        "zh": "内置预置音色。"
      },
      "num_inference_steps": {
        "en": "Diffusion steps per acoustic frame, from 1 to 1000; omitted uses the checkpoint's diffusion_head_config.ddpm_num_inference_steps.",
        "zh": "每个声学帧的扩散步数，1 到 1000；省略时使用检查点 diffusion_head_config.ddpm_num_inference_steps。"
      },
      "guidance_scale": {
        "en": "Diffusion classifier-free guidance; 1 disables the unconditional pass. Any finite value is accepted; negative values enter CFG arithmetic.",
        "zh": "扩散无分类器引导强度；1 关闭无条件分支。接受任意有限值；负值会参与 CFG 计算。"
      },
      "max_tokens": {
        "en": "Maximum autoregressive tokens per text chunk.",
        "zh": "每个文本分块的最大自回归 token 数。"
      },
      "do_sample": {
        "en": "Sample autoregressive speech control tokens instead of greedy decoding.",
        "zh": "对自回归语音控制 token 采样，而不是贪心解码。"
      },
      "temperature": {
        "en": "Autoregressive sampling temperature when do_sample is enabled. Any finite value is accepted; negative values disable sampling.",
        "zh": "启用 do_sample 时的自回归采样温度。接受任意有限值；负值关闭采样。"
      },
      "seed": {
        "en": "Random seed; -1 chooses a random seed.",
        "zh": "随机种子；-1 表示随机选择。"
      },
      "text_chunk_size": {
        "en": "Maximum Unicode codepoints per long-form text chunk.",
        "zh": "长文本分块的最大 Unicode 码点数。"
      },
      "text_chunk_mode": {
        "en": "Framework long-form text splitting mode.",
        "zh": "框架长文本切分模式。"
      }
    }
  },
