  "i18n": {
    "description": {
      "en": "Sample-rate-independent speech restoration with bidirectional Mamba.",
      "zh": "基于双向 Mamba 的采样率无关语音修复。"
    },
    "options": {
      "audio_chunk_duration_sec": {
        "en": "Chunk duration in seconds; zero processes the whole recording. When enabled, the chunk sample count must exceed sample_rate/50. Chunking changes bidirectional and normalization context. Native batching requires zero; positive chunk durations are supported only for single requests.",
        "zh": "分块时长（秒）；0 表示处理整段录音。启用时分块采样数必须大于 sample_rate/50。分块会改变双向与归一化上下文。原生批处理要求为 0；正值分块仅支持单请求。"
      },
      "audio_chunk_overlap_sec": {
        "en": "Hann-weighted overlap in seconds, shorter than the chunk duration. Applies only to single-request chunking; native batching ignores this setting.",
        "zh": "Hann 加权重叠时长（秒），需小于分块时长。仅适用于单请求分块；原生批处理忽略此设置。"
      }
    }
  },
