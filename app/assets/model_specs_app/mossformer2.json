      },
      "normalize_output": {
        "en": "Match each trimmed track RMS to the input as in ClearVoice's NumPy interface.",
        "zh": "按 ClearVoice NumPy 接口，将每条裁剪后轨道的 RMS 匹配到输入。"
      }
    }
