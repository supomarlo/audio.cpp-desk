  "i18n": {
    "description": {
      "en": "Maya Research's 3B expressive English text-to-speech model with natural-language voice design and inline emotion control.",
      "zh": "Maya Research 的 3B 表现力英语 TTS 模型，支持自然语言音色设计与行内情绪控制。"
    },
    "options": {
      "instruct": {
        "en": "Natural-language description of the voice, accent, timbre, age, and delivery.",
        "zh": "音色、口音、音质、年龄与表达方式的自然语言描述。"
      },
      "max_tokens": {
        "en": "Maximum generated audio-token count per text chunk; default 2048.",
        "zh": "每个文本分块生成的最大音频 token 数；默认 2048。"
      },
      "min_tokens": {
        "en": "Minimum generated audio-token count before EOS may stop generation; default 28.",
        "zh": "EOS 可停止生成前的最小音频 token 数；默认 28。"
      },
      "temperature": {
        "en": "Autoregressive sampling temperature; default 0.4. Must be > 0.",
        "zh": "自回归采样温度；默认 0.4，必须 > 0。"
      },
      "top_p": {
        "en": "Autoregressive nucleus sampling probability; must be in (0, 1], default 0.9.",
        "zh": "自回归核采样概率；必须在 (0, 1] 内，默认 0.9。"
      },
      "repetition_penalty": {
        "en": "Autoregressive repetition penalty; default 1.1. Must be > 0.",
        "zh": "自回归重复惩罚；默认 1.1，必须 > 0。"
      },
      "seed": {
        "en": "Sampling and SNAC decoder noise seed; omitted requests choose a random seed.",
        "zh": "采样与 SNAC 解码器噪声种子；省略时随机选择。"
      },
      "text_chunk_size": {
        "en": "Maximum Unicode codepoints per long-form text chunk; default 300.",
        "zh": "每个长文本分块的最大 Unicode 码点数；默认 300。"
      },
      "text_chunk_mode": {
        "en": "Framework long-form text chunking mode; tag_aware preserves inline emotion tags.",
        "zh": "框架长文本分块模式；tag_aware 保留行内情绪标签。"
      }
    }
  }
