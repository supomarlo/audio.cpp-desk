  "dependencies": [],
  "options": {
    "request": [
      {
        "name": "return_timestamps",
        "type": "bool",
        "description": "Return word timestamps derived from decoder token emission frames.",
        "required": false,
        "default": false
      },
      {
        "name": "audio_chunk_mode",
        "type": "enum",
        "description": "Long-form audio chunking mode.",
        "values": [
          "auto",
          "fixed",
          "quiet_energy",
          "vad",
          "none"
        ],
        "required": false,
        "default": "auto"
      },
      {
        "name": "audio_chunk_duration_sec",
        "type": "float",
        "description": "Maximum duration of each audio chunk in seconds.",
        "required": false,
        "min": 0.02,
        "max": 25,
        "default": 25
      }
    ],
    "session": [
      {
        "name": "vad_model_path",
        "type": "path",
        "description": "Offline VAD model used only with audio_chunk_mode=vad.",
        "required": false,
        "default": ""
      },
      {
        "name": "weight_type",
        "type": "enum",
        "description": "Weight storage type.",
        "preset": "weight_type_full",
        "required": false,
        "default": "native"
      }
    ],
    "load": []
  },
