  "i18n": {
    "description": {
      "en": "Microsoft long-form multi-speaker TTS model for expressive conversational audio such as podcasts, supporting up to 90 minutes of speech with as many as four speakers.",
      "zh": "微软长音频多说话人 TTS 模型，面向播客等富有表现力的对话音频，支持最长 90 分钟语音、最多四位说话人。"
    },
    "options": {
      "voice_samples": {
        "en": "Comma-separated reference WAV paths ordered by speaker ID; cannot be combined with voice_ref.",
        "zh": "按说话者 ID 排序的逗号分隔参考 WAV 路径；不能与 voice_ref 结合使用。"
      },
      "num_inference_steps": {
        "en": "Diffusion steps; defaults to the checkpoint configuration.",
        "zh": "扩散步骤；默认为检查点配置。"
      },
      "guidance_scale": {
        "en": "Classifier-free guidance scale.",
        "zh": "无分类器引导强度。"
      },
      "max_length_times": {
        "en": "Positive generation length multiplier.",
        "zh": "正生成长度乘数。"
      },
      "temperature": {
        "en": "Positive sampling temperature.",
        "zh": "正采样温度。"
      },
      "top_k": {
        "en": "Top-k sampling limit; zero disables filtering.",
        "zh": "Top-k采样限制；零禁用过滤。"
      },
      "top_p": {
        "en": "Nucleus probability in (0, 1].",
        "zh": "(0, 1] 中的核概率。"
      },
      "seed": {
        "en": "Sampling seed.",
        "zh": "取样种子。"
      },
      "max_tokens": {
        "en": "Maximum generated tokens; zero uses the model-derived limit.",
        "zh": "最大生成代币；零使用模型导出的极限。"
      },
      "do_sample": {
        "en": "Enable sampling.",
        "zh": "启用采样。"
      },
      "prompt_noise_file": {
        "en": "F32 prompt acoustic noise file.",
        "zh": "F32 提示声学噪声文件。"
      },
      "diffusion_noise_file": {
        "en": "F32 initial diffusion noise file.",
        "zh": "F32 初始扩散噪声文件。"
      }
    }
  },
