    "description": {
      "en": "Flagship MOSS-TTS model for high-fidelity 31-language and code-switched speech, zero-shot voice cloning, long-form generation, and fine-grained Pinyin, phoneme, and duration control.",
      "zh": "旗舰 MOSS-TTS 模型，面向高保真 31 语言与语码混用语音、零样本音色克隆、长文本生成，以及细粒度拼音、音素与时长控制。"
    },
    "options": {
      "max_tokens": {
        "en": "Maximum generated audio frames.",
        "zh": "最多生成的音频帧数。"
      },
      "temperature": {
        "en": "Audio sampling temperature. Must be finite and positive when sampling.",
        "zh": "音频采样温度。采样时必须是有限且正的。"
      },
      "top_p": {
        "en": "Audio nucleus sampling probability.",
        "zh": "音频核采样概率。"
      },
