      },
      "text_temperature": {
        "en": "Text sampling temperature. Must be finite and positive when sampling.",
        "zh": "文本采样温度。采样时必须是有限且正的。"
      },
      "text_top_p": {
        "en": "Text nucleus sampling probability.",
        "zh": "文本核采样概率。"
      },
      "text_top_k": {
        "en": "Text top-k sampling limit.",
        "zh": "文本 top-k 采样限制。"
      },
      "seed": {
        "en": "Sampling seed; omitted chooses a random seed.",
        "zh": "种子取样；省略选择随机种子。"
      },
      "do_sample": {
        "en": "Enable sampling.",
        "zh": "启用采样。"
      },
      "text_chunk_size": {
        "en": "Framework long-form text chunk size.",
        "zh": "框架长文本分块大小。"
      },
      "text_chunk_mode": {
        "en": "Framework text chunking mode.",
        "zh": "框架文本分块模式。"
      }
    }
