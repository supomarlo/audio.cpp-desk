{
  "family": "vibevoice_asr_streaming",
  "i18n": {
    "description": {
      "en": "Microsoft VibeVoice ASR Streaming models (7B and 1.5B) for chunked streaming speech-to-text with persistent decoder state.",
      "zh": "微软 VibeVoice ASR Streaming 模型（7B 与 1.5B），面向带持久解码器状态的分块流式语音转文本。"
    },
    "options": {
      "language": {
        "en": "ASR language label; empty unless provided in the request.",
        "zh": "ASR 语言标签；除非请求中提供，否则为空。"
      },
      "context": {
        "en": "Extra context or hotwords injected into the streaming prompt.",
        "zh": "注入流式提示的额外上下文或热词。"
      },
      "max_tokens": {
        "en": "Maximum generated transcript tokens per chunk.",
        "zh": "每个分块最多生成的转写 token 数。"
      },
      "temperature": {
        "en": "Sampling temperature; 0 uses deterministic decoding.",
        "zh": "采样温度；0 表示确定性解码。"
      },
      "top_p": {
        "en": "Nucleus sampling probability.",
        "zh": "核采样概率。"
      },
      "top_k": {
        "en": "Top-k sampling limit; default 50. Zero disables top-k filtering.",
        "zh": "Top-k采样限制；默认值 50。零禁用 top-k 过滤。"
      },
      "repetition_penalty": {
        "en": "Generation repetition penalty.",
        "zh": "生成重复惩罚。"
      },
      "seed": {
        "en": "Acoustic latent sampling seed; default 1234.",
        "zh": "声学潜伏采样种子；默认 1234。"
      },
      "audio_chunk_mode": {
        "en": "Compatibility-only; ignored in offline and streaming modes. Processor chunk/lookahead settings determine segmentation.",
        "zh": "仅兼容性；在离线和流媒体模式下被忽略。处理器块/前瞻设置决定分段。"
      },
      "audio_chunk_duration_sec": {
        "en": "Compatibility-only; ignored in offline and streaming modes. Processor settings determine segmentation.",
        "zh": "仅兼容性；在离线和流媒体模式下被忽略。处理器设置决定分段。"
      },
      "num_beams": {
        "en": "Compatibility-only; this checkpoint ignores beam search and uses its incremental decoder.",
        "zh": "仅兼容；该检查点忽略 beam search，使用增量解码器。"
      }
    }
  },
