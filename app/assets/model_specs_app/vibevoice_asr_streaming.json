    "description": {
      "en": "Microsoft VibeVoice ASR Streaming models (7B and 1.5B) for chunked streaming speech-to-text with persistent decoder state.",
      "zh": "微软 VibeVoice ASR Streaming 模型（7B 与 1.5B），面向带持久解码器状态的分块流式语音转文本。"
    },
    "options": {
      "language": {
        "en": "ASR language label.",
        "zh": "ASR 语言标记。"
      },
      "context": {
        "en": "Extra context or hotwords injected into the streaming prompt.",
        "zh": "注入流式提示的额外上下文或热词。"
      },
      "max_tokens": {
        "en": "Maximum generated transcript tokens per chunk.",
        "zh": "每个分块最多生成的转写 token 数。"
      },
      "temperature": {
        "en": "Sampling temperature; 0 uses deterministic decoding.",
        "zh": "采样温度；0 表示确定性解码。"
      },
      "top_p": {
        "en": "Nucleus sampling probability.",
        "zh": "核采样概率。"
      },
      "top_k": {
        "en": "Top-k sampling limit; 0 disables top-k filtering.",
        "zh": "top-k 采样上限；0 表示关闭 top-k 过滤。"
      },
      "repetition_penalty": {
        "en": "Generation repetition penalty.",
        "zh": "生成重复惩罚。"
      },
      "seed": {
        "en": "Acoustic latent sampling seed.",
        "zh": "声学隐变量采样的随机种子。"
      },
      "audio_chunk_mode": {
        "en": "Offline audio chunking mode: auto, fixed, vad, or none.",
        "zh": "离线音频分块模式：auto、fixed、vad 或 none。"
      },
      "audio_chunk_duration_sec": {
        "en": "Audio chunk duration in seconds for fixed and VAD chunking.",
        "zh": "fixed 与 VAD 分块时的音频分块时长（秒）。"
      }
    }
