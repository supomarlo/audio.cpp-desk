    "description": {
      "en": "Japanese TTS model based on RF-DiT continuous audio latents, supporting zero-shot voice cloning, automatic duration prediction, multimodal voice design, and emoji-style control.",
      "zh": "基于 RF-DiT 连续音频潜在的日语 TTS 模型，支持零样本音色克隆、自动时长预测、多模态声音设计与 emoji 风格控制。"
    },
    "options": {
      "language": {
        "en": "Text language code; Irodori-TTS supports Japanese only.",
        "zh": "文本语言代码；Irodori-TTS 仅支持日语。"
      },
      "instruction": {
        "en": "Natural-language voice or style instruction describing target voice identity, style, or emotion; supported only by caption-conditioned checkpoints. Legacy caption is accepted as an alias.",
        "zh": "用自然语言描述目标音色身份、风格或情绪的声音/风格指令；仅 caption 条件化的检查点支持。旧名 caption 可作为别名。"
      },
      "no_ref": {
        "en": "Use no-reference generation; default true unless a speaker reference is provided.",
        "zh": "使用无参考生成；默认 true，除非提供了说话人参考。"
      },
      "num_inference_steps": {
        "en": "RF diffusion steps; default 40.",
        "zh": "RF 扩散步数；默认 40。"
      },
      "duration_sec": {
        "en": "Explicit output duration in seconds; must be positive when set, otherwise predicted duration is used.",
        "zh": "显式输出时长（秒）；设置时须为正数，否则使用预测时长。"
      },
      "duration_scale": {
        "en": "Predicted-duration multiplier; must be positive when set; default 1.0.",
        "zh": "预测时长的倍率；设置时须为正数；默认 1.0。"
      },
      "min_duration_sec": {
        "en": "Minimum generated duration in seconds; must be positive and no greater than max_duration_sec; default 0.5.",
        "zh": "生成时长下限（秒）；须为正数且不大于 max_duration_sec；默认 0.5。"
      },
      "max_duration_sec": {
        "en": "Maximum generated duration in seconds; must be at least min_duration_sec; default 30.",
        "zh": "生成时长上限（秒）；须不小于 min_duration_sec；默认 30。"
      },
      "text_guidance_scale": {
        "en": "Text classifier-free guidance scale; default 3.0.",
        "zh": "文本无分类器引导强度；默认 3.0。"
      },
      "speaker_guidance_scale": {
        "en": "Speaker classifier-free guidance scale; default 5.0.",
        "zh": "说话人无分类器引导强度；默认 5.0。"
      },
      "caption_guidance_scale": {
        "en": "Caption classifier-free guidance scale; default 3.0.",
        "zh": "caption 无分类器引导强度；默认 3.0。"
      },
      "guidance_scale": {
        "en": "Override all classifier-free guidance scales when set.",
        "zh": "设置后覆盖所有无分类器引导强度。"
      },
      "guidance_mode": {
        "en": "Classifier-free guidance combination mode; default independent.",
        "zh": "无分类器引导的组合方式；默认 independent。"
      },
      "guidance_min_t": {
        "en": "Minimum diffusion timestep value where guidance is active; default 0.5.",
        "zh": "引导生效的扩散时间步最小值；默认 0.5。"
