        "en": "Continuation window planning. None requires audio no longer than 30 seconds.",
        "zh": "续接窗口规划。none 要求音频不超过 30 秒。"
      },
      "audio_chunk_duration_sec": {
        "en": "Duration of each encoder window in seconds. Must be positive and greater than overlap.",
        "zh": "每个编码器窗口的时长（秒）；必须为正且大于重叠时长。"
      },
      "audio_chunk_overlap_sec": {
        "en": "Audio overlap between continuation windows in seconds. Must be smaller than chunk duration.",
        "zh": "续接窗口之间的音频重叠时长（秒）；必须小于分块时长。"
      },
      "language": {
        "en": "Audio language code.",
        "zh": "音频语言代码。"
      },
      "transcription_mode": {
        "en": "Verbatim speech, intended clean text, or transcript-conditioned verbatimize.",
        "zh": "逐字转写、意图清理文本，或基于转写结果的逐字化。"
      },
      "max_tokens": {
        "en": "Maximum generated tokens per window. Positive budget, additionally bounded by remaining checkpoint text positions after the prompt.",
        "zh": "每个窗口生成的最大 token 数。预算必须为正，并受提示之后剩余文本位置限制。"
      }
    }
  },
