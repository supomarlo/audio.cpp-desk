  "family": "crisperwhisper",
  "i18n": {
    "description": {
      "en": "Whisper-based verbatim and intended speech transcription.",
      "zh": "基于 Whisper 的逐字转写与意图文本转写。"
    },
    "options": {
      "return_timestamps": {
        "en": "Return word-level timestamps.",
        "zh": "返回词级时间戳。"
      },
