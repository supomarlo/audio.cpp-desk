  "options": {
    "request": [
      {
        "name": "return_timestamps",
        "required": false,
        "type": "bool",
        "description": "Return word-level timestamps.",
        "default": false
      },
      {
        "name": "audio_chunk_mode",
        "required": false,
        "type": "enum",
        "values": [
          "auto",
          "fixed",
          "none"
        ],
        "description": "Continuation window planning. None requires audio no longer than 30 seconds.",
        "default": "auto"
      },
      {
        "name": "audio_chunk_duration_sec",
        "required": false,
        "type": "float",
        "description": "Duration of each encoder window in seconds. Must be positive and greater than overlap.",
        "max": 30,
        "default": 30
      },
      {
        "name": "audio_chunk_overlap_sec",
        "required": false,
        "type": "float",
        "description": "Audio overlap between continuation windows in seconds. Must be smaller than chunk duration.",
        "min": 0,
        "default": 4
      },
      {
        "name": "language",
        "required": false,
        "type": "string",
        "description": "Audio language code.",
        "default": "en"
      },
      {
        "name": "transcription_mode",
        "required": false,
        "type": "enum",
        "description": "Verbatim speech, intended clean text, or transcript-conditioned verbatimize.",
        "values": [
          "verbatim",
          "intended",
          "verbatimize"
        ],
        "default": "verbatim"
      },
      {
        "name": "max_tokens",
        "required": false,
        "type": "int",
        "description": "Maximum generated tokens per window. Positive budget, additionally bounded by remaining checkpoint text positions after the prompt.",
        "min": 1,
        "default": 256
      }
    ],
    "session": [
      {
        "name": "weight_type",
        "required": false,
        "type": "enum",
        "values": [
