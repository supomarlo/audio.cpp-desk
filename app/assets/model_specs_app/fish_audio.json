    "description": {
      "en": "Fish Audio S2 Pro text-to-speech model for expressive speech across 80+ languages, with automatic language handling, inline prosody/emotion controls, and rapid voice cloning from short reference samples.",
      "zh": "Fish Audio S2 Pro 文本转语音模型，覆盖 80+ 语言的富有表现力语音，自动处理语言，支持行内韵律/情绪控制，并可从短参考样本快速克隆音色。"
    },
    "options": {
      "reference_text": {
        "en": "Reference transcript used with speaker reference audio.",
        "zh": "配合说话人参考音频使用的参考文本。"
      },
      "multi_reference_cond": {
        "en": "Fish Audio ordered JSON array of reference conditioning pairs for one generated speaker: [{\"audio\":\"ref1.wav\",\"text\":\"Transcript one.\"},{\"audio\":\"ref2.wav\",\"text\":\"Transcript two.\"}]. This is not a multi-speaker dialogue routing option.",
        "zh": "Fish Audio 针对单个生成说话人的有序参考条件对 JSON 数组：[{\"audio\":\"ref1.wav\",\"text\":\"Transcript one.\"},{\"audio\":\"ref2.wav\",\"text\":\"Transcript two.\"}]。注意这不是多说话人对话路由选项。"
      },
      "max_new_tokens": {
        "en": "Maximum Fish Audio semantic tokens to generate; default 1024.",
        "zh": "最多生成的 Fish Audio 语义 token 数；默认 1024。"
      },
      "top_p": {
        "en": "Top-p sampling value in (0, 1]; default 0.8.",
        "zh": "Top-p 采样值，取值 (0, 1]；默认 0.8。"
      },
      "top_k": {
        "en": "Top-k sampling value; default 30.",
        "zh": "Top-k 采样值；默认 30。"
      },
      "temperature": {
        "en": "Semantic-token sampling temperature in (0, 2); default 0.8.",
        "zh": "语义 token 采样温度，取值 (0, 2)；默认 0.8。"
      },
      "seed": {
        "en": "Sampling seed for reproducible output; omitted uses a random seed.",
        "zh": "用于可复现输出的采样随机种子；省略时随机。"
      }
    }
