{
  "family": "moss_tts_nano",
  "i18n": {
    "description": {
      "en": "Compact deployment-first MOSS-TTS model for real-time multilingual speech generation, lightweight integration, and zero-shot voice cloning.",
      "zh": "紧凑、部署优先的 MOSS-TTS 模型，面向实时多语言语音生成、轻量集成与零样本音色克隆。"
    },
    "options": {
      "max_tokens": {
        "en": "Maximum generated audio frames.",
        "zh": "最多生成的音频帧数。"
      },
      "temperature": {
        "en": "Audio sampling temperature. Must be positive, including when do_sample=false.",
        "zh": "音频采样温度。必须为正，包括 do_sample=false 时。"
      },
      "top_p": {
        "en": "Audio nucleus sampling probability.",
        "zh": "音频核采样概率。"
      },
      "top_k": {
        "en": "Audio top-k sampling limit.",
        "zh": "音频 top-k 采样限制。"
      },
      "repetition_penalty": {
        "en": "Audio repetition penalty. Must be positive.",
        "zh": "音频重复惩罚。必须是积极的。"
      },
      "text_temperature": {
        "en": "Text sampling temperature. Must be positive, including when do_sample=false.",
        "zh": "文本采样温度。必须为正，包括 do_sample=false 时。"
      },
      "text_top_p": {
        "en": "Text nucleus sampling probability.",
        "zh": "文本核采样概率。"
      },
      "text_top_k": {
        "en": "Text top-k sampling limit.",
        "zh": "文本 top-k 采样限制。"
      },
      "seed": {
        "en": "Sampling seed; omitted chooses a random seed.",
        "zh": "种子取样；省略选择随机种子。"
      },
      "reference_text": {
        "en": "Transcript for reference audio; a nonempty value requires voice reference audio.",
        "zh": "参考音频对应的转写文本；非空值需要参考音频。"
      },
      "active_codebooks": {
        "en": "Active codebooks; defaults to the checkpoint n_vq. Must not exceed checkpoint n_vq; omitted uses n_vq.",
        "zh": "启用的 codebook 数；默认使用检查点 n_vq，不得超过 n_vq；省略时使用 n_vq。"
      },
      "do_sample": {
        "en": "Enable sampling.",
        "zh": "启用采样。"
      },
      "text_chunk_size": {
        "en": "Framework long-form text chunk size; default 50 when hanzi, kana and Hangul outnumber other letters and digits, otherwise 256.",
        "zh": "框架长文本分块大小；汉字、假名与韩文多于其它字母和数字时默认 50，否则 256。"
      },
      "text_chunk_mode": {
        "en": "Framework text chunking mode.",
        "zh": "框架文本分块模式。"
      }
    }
  },
