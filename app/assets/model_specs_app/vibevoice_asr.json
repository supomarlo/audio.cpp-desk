  "i18n": {
    "description": {
      "en": "Microsoft long-form speech-to-text model that processes up to 60 minutes of audio in one pass and produces structured transcripts with speakers, timestamps, content, hotwords, and 50+ language support.",
      "zh": "微软长音频语音转文本模型，单次可处理最长 60 分钟音频，输出含说话人、时间戳、内容、热词的结构化转写，支持 50+ 语言。"
    },
    "options": {
      "language": {
        "en": "ASR language label.",
        "zh": "ASR 语言标记。"
      },
      "max_tokens": {
        "en": "Maximum generated text tokens.",
        "zh": "最多生成的文本 token 数。"
      },
      "temperature": {
        "en": "Sampling temperature; zero uses deterministic decoding.",
        "zh": "采样温度；零使用确定性解码。"
      },
      "top_p": {
        "en": "Nucleus probability in (0, 1].",
        "zh": "(0, 1] 中的核概率。"
      },
      "top_k": {
        "en": "Top-k sampling limit; zero disables filtering.",
        "zh": "Top-k采样限制；零禁用过滤。"
      },
      "repetition_penalty": {
        "en": "Positive generation repetition penalty.",
        "zh": "正生成重复惩罚。"
      },
      "seed": {
        "en": "Acoustic latent sampling seed.",
        "zh": "声学隐变量采样的随机种子。"
      },
      "audio_chunk_mode": {
        "en": "Pre-encoder audio splitting; auto uses fixed chunks.",
        "zh": "预编码器音频分割； auto 使用固定块。"
      },
      "audio_chunk_duration_sec": {
        "en": "Positive audio chunk duration in seconds.",
        "zh": "正音频块持续时间（以秒为单位）。"
      },
      "context": {
        "en": "Context hint; context_info is also accepted.",
        "zh": "上下文提示； context_info 也被接受。"
      },
      "num_beams": {
        "en": "Deterministic beam search width.",
        "zh": "确定性 beam search 宽度。"
      }
    }
  },
