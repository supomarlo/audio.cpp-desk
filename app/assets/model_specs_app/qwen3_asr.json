{
  "family": "qwen3_asr",
  "i18n": {
    "description": {
      "en": "Qwen ASR model family for language identification and speech recognition across 30 languages, 22 Chinese dialects, and multiple English accents, with robustness for noisy, long-form, and singing audio.",
      "zh": "Qwen ASR 模型家族，覆盖 30 种语言、22 种中文方言与多种英语口音的语言识别与语音识别，对噪声、长音频与歌唱音频具备稳健性。"
    },
    "ui": {
      "pickMedia": {
        "en": "Choose media",
        "zh": "选择媒体"
      },
      "audioChunkMode.auto": {
        "en": "Auto",
        "zh": "自动"
      },
      "audioChunkMode.fixed": {
        "en": "Fixed chunks",
        "zh": "固定分块"
      },
      "audioChunkMode.vad": {
        "en": "VAD chunks",
        "zh": "VAD 分块"
      },
      "audioChunkMode.none": {
        "en": "No chunking",
        "zh": "不分块"
      }
    },
    "options": {
      "language": {
        "en": "Recognition language code or label; leave empty for automatic detection",
        "zh": "识别语言代码或标签，留空自动检测"
      },
      "max_tokens": {
        "en": "Maximum transcript tokens per audio chunk; default 512",
        "zh": "每段音频转写生成的最大 token 数，默认 512"
      },
      "audio_chunk_mode": {
        "en": "Audio chunking mode",
        "zh": "音频分块模式"
      },
      "audio_chunk_duration_sec": {
        "en": "Maximum audio chunk duration in seconds; ignored offline when audio_chunk_mode is none",
        "zh": "音频分块的最大时长（秒），离线且不分块时忽略"
      },
      "return_timestamps": {
        "en": "Return word-level timestamps; requires the Qwen3 Forced Aligner model and works offline only",
        "zh": "返回词级时间戳，需同时安装 Qwen3 Forced Aligner 模型，且仅限离线模式"
      },
      "clamp_timestamps_to_audio": {
        "en": "Keep word timestamps within the current audio chunk",
        "zh": "将词级时间戳限制在当前音频分块内"
      },
      "preserve_punctuation": {
        "en": "Keep the original ASR text and punctuation, skipping post-alignment text reconstruction",
        "zh": "保留 ASR 原文与标点，跳过对齐后的文本重建"
      }
    }
  },
