{
  "family": "f5_tts",
  "i18n": {
    "description": {
      "en": "Community F5-TTS flow-matching diffusion transformer for zero-shot voice cloning, including Arabic via the Habibi-TTS finetune (SWivid). Text conv conditioner, RoPE DiT, CFM sampler, Vocos vocoder.",
      "zh": "社区 F5-TTS 流匹配扩散 Transformer，用于零样本音色克隆，含 Habibi-TTS 微调带来的阿拉伯语支持（SWivid）。文本卷积条件器、RoPE DiT、CFM 采样器、Vocos 声码器。"
    },
    "options": {
      "reference_text": {
        "en": "Transcript matching the reference voice audio; required by F5-TTS zero-shot cloning.",
        "zh": "与参考语音音频对应的文本；F5-TTS 零样本克隆必填。"
      },
      "dialect": {
        "en": "Habibi dialect token: UNK MSA SAU UAE ALG IRQ EGY MAR OMN TUN LEV SDN LBY; default UNK.",
        "zh": "Habibi 方言标记：UNK MSA SAU UAE ALG IRQ EGY MAR OMN TUN LEV SDN LBY；默认 UNK。"
      },
      "speed": {
        "en": "Speech speed multiplier for duration estimation; default 1.0. Generated text chunks shorter than 10 characters use 0.3 instead. Advertised bounds are recommended settings, not parser-enforced limits.",
        "zh": "用于持续时间估计的语音速度乘数；默认 1.0。生成的文本块少于 10 个字符，使用 0.3 代替。公布的边界是建议的设置，而不是解析器强制的限制。"
      },
      "seed": {
        "en": "Non-negative noise seed; omitted selects a random seed. Explicit zero is deterministic.",
        "zh": "非负噪声种子；省略选择随机种子。显式零是确定性的。"
      },
      "num_inference_steps": {
        "en": "CFM Euler steps (NFE); default 32. The parser rejects nonpositive counts.",
        "zh": "CFM 欧拉步 (NFE)；默认值 32。解析器拒绝非正计数。"
      },
      "guidance_scale": {
        "en": "Classifier-free guidance strength; default 2.0. Advertised bounds are recommended settings, not parser-enforced limits.",
        "zh": "无分类器引导强度；默认 2.0。公布的边界是建议的设置，而不是解析器强制的限制。"
      },
      "strip_diacritics": {
        "en": "Strip Arabic combining marks (harakat/tanwin/shadda/tatweel) before synthesis; Habibi is trained on undiacritized ASR transcripts and garbles diacritized input. Default true.",
        "zh": "合成前去除阿拉伯语的组合符号（harakat/tanwin/shadda/tatweel）；Habibi 基于无附加符号的 ASR 转写训练，带有附加符号的输入会被读错。默认 true。"
      },
      "sway_sampling_coef": {
        "en": "Sway sampling coefficient for inference timesteps; default -1.0. Advertised bounds are recommended settings, not parser-enforced limits.",
        "zh": "推理时间步的 Sway Sampling 系数；默认 -1.0。建议边界仅作参考，解析器不强制。"
      }
    }
  },
