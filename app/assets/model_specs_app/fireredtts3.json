{
  "family": "fireredtts3",
  "i18n": {
    "description": {
      "en": "FireRedTTS3 family for Base zero-shot voice cloning and Instruct instruction-conditioned TTS, voice design, semantic edit, and acoustic edit with Qwen3 autoregressive hidden-state generation, FireRed DiT latent patch flow, and RedAE waveform decoding.",
      "zh": "FireRedTTS3 家族，含 Base 零样本音色克隆与 Instruct 指令条件 TTS、声音设计、语义编辑与声学编辑，采用 Qwen3 自回归隐状态生成、FireRed DiT 潜块流与 RedAE 波形解码。"
    },
    "options": {
      "template_name": {
        "en": "Instruct template; defaults to acoustic_edit with input audio, otherwise instruct_tts.",
        "zh": "指导模板；默认为有输入音频的 Acoustic_edit，否则为 instruct_tts。"
      },
      "reference_text": {
        "en": "Transcript for the prompt audio.",
        "zh": "提示音频对应的文本。"
      },
      "language": {
        "en": "Language tag used by FireRedTTS3.",
        "zh": "FireRedTTS3 使用的语言标记。"
      },
      "num_inference_steps": {
        "en": "FireRed DiT flow steps per generated latent patch.",
        "zh": "每个生成隐变量 patch 的 FireRed DiT 流步数。"
      },
      "guidance_scale": {
        "en": "Positive guidance scale; defaults to 1.2 for voice-design/semantic-edit/acoustic-edit templates and 2 otherwise.",
        "zh": "正向引导量表；语音设计/语义编辑/声学编辑模板默认为 1.2，否则默认为 2。"
      },
      "stop_threshold": {
        "en": "Stop probability threshold for AR patch generation.",
        "zh": "AR patch 生成的停止概率阈值。"
      },
      "seed": {
        "en": "Unsigned 32-bit sampling seed in [0, 4294967295]; defaults to 2 for voice design and 1234 otherwise.",
        "zh": "[0, 4294967295] 中的无符号 32 位采样种子；语音设计默认为 2，否则默认为 1234。"
      },
      "instruct": {
        "en": "FireRedTTS3 instruction for voice design or edit tasks.",
        "zh": "用于音色设计或编辑任务的 FireRedTTS3 指令。"
      },
      "text_chunk_size": {
        "en": "Maximum Unicode codepoints per long-form text chunk; default 80 when hanzi, kana and Hangul outnumber other letters and digits (except edits), otherwise 600.",
        "zh": "长文本分块的最大 Unicode 码点数；汉字、假名与韩文多于其它字母和数字时默认 80（编辑除外），否则 600。"
      },
      "text_chunk_mode": {
        "en": "Framework text chunking mode.",
        "zh": "框架文本分块模式。"
      }
    }
  },
