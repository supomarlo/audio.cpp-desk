{
  "family": "hviske_asr",
  "schema_version": 1,
  "display_name": "Hviske ASR",
  "description": "Danish-optimized Conformer encoder-decoder ASR model fine-tuned from the Hviske v5 family, with selectable Cohere ASR language prompts.",
  "category": "asr",
  "status": "supported",
  "tasks": [
    "asr"
  ],
