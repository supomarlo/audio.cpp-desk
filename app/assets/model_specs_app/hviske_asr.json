    "options": {
      "language": {
        "en": "ASR language code; default da.",
        "zh": "ASR 语言代码；默认 da。"
      },
      "punctuation": {
        "en": "Enable or disable punctuation tokens in the decoder prompt; default true.",
        "zh": "在解码提示中启用或关闭标点 token；默认 true。"
      },
      "max_tokens": {
        "en": "Maximum generated transcript tokens; defaults to the model config.",
        "zh": "最多生成的转写 token 数；默认取模型配置。"
      },
      "temperature": {
        "en": "Decoder sampling temperature; must be positive when set; default 1.0.",
        "zh": "解码器采样温度；设置时须为正数；默认 1.0。"
      },
      "top_k": {
        "en": "Top-k sampling limit; default 50, 0 disables top-k.",
        "zh": "top-k 采样上限；默认 50，0 表示关闭 top-k。"
      },
      "top_p": {
        "en": "Nucleus sampling limit in (0, 1]; default 1.0.",
        "zh": "核采样上限，取值 (0, 1]；默认 1.0。"
      },
      "seed": {
        "en": "Decoder sampling seed; random if omitted.",
        "zh": "解码器采样随机种子；省略时随机。"
      },
      "audio_chunk_mode": {
        "en": "Audio chunking mode; default auto uses quiet-energy splitting only when audio exceeds the model clip window.",
        "zh": "音频分块模式；默认 auto 仅在音频超过模型片段窗口时使用静音能量切分。"
      },
      "audio_chunk_duration_sec": {
        "en": "Maximum audio chunk duration in seconds; defaults to the model clip window.",
        "zh": "音频分块的最大时长（秒）；默认取模型片段窗口。"
      }
    }
