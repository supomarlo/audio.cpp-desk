{
  "family": "audio_flamingo",
  "i18n": {
    "description": {
      "en": "Audio Flamingo 3 and Audio Flamingo Next models for transcription, captioning, and questions about speech, music, and environmental sounds.",
      "zh": "Audio Flamingo 3 / Next 模型，支持语音转写、音频描述，以及针对语音、音乐和环境声的问答。"
    },
    "options": {
      "instruct": {
        "en": "Question or instruction about the input audio.",
        "zh": "关于输入音频的问题或指令。"
      },
      "max_tokens": {
        "en": "Maximum generated response tokens. Defaults to checkpoint generation configuration (2048 fallback); prompt plus output budget must fit model positions.",
        "zh": "生成回复的最大 token 数。默认使用模型检查点的生成配置（回退 2048）；提示与输出预算必须能放入模型位置上限。"
      },
      "do_sample": {
        "en": "Sample tokens instead of greedy decoding.",
        "zh": "使用采样生成 token，而不是贪心解码。"
      },
      "temperature": {
        "en": "Sampling temperature. Used only when do_sample=true; must be positive when sampling.",
        "zh": "采样温度；仅在 do_sample=true 时生效，采样时必须为正。"
      },
      "top_k": {
        "en": "Sampling candidate count; zero disables top-k filtering. Used only when sampling; nonpositive values disable top-k filtering.",
        "zh": "采样候选数量；0 关闭 top-k 过滤。仅在采样时生效；非正值关闭 top-k 过滤。"
      },
      "top_p": {
        "en": "Nucleus sampling probability. Used only when sampling; zero is accepted and values >=1 disable nucleus filtering.",
        "zh": "核采样概率；仅在采样时生效；接受 0，>=1 时关闭核采样过滤。"
      },
      "repetition_penalty": {
        "en": "Token repetition penalty. Must be positive.",
        "zh": "token 重复惩罚；必须为正。"
      },
      "seed": {
        "en": "Sampling seed. Parsed as a signed integer and converted to uint32.",
        "zh": "采样随机种子；按有符号整数解析后转换为 uint32。"
      }
    }
  },
