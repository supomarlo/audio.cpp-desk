{
  "family": "auk",
  "i18n": {
    "description": {
      "en": "Tencent AuK base and AuK-Flash speech generation and editing models.",
      "zh": "腾讯 AuK 与 AuK-Flash 语音生成与编辑模型。"
    },
    "options": {
      "instruct": {
        "en": "TTS voice description. Without it, text carries the complete upstream instruction; editing instructions always go in text.",
        "zh": "TTS 音色描述。不填时由文本承载完整的上游指令；编辑类指令始终写在文本里。"
      },
      "duration_sec": {
        "en": "Positive output duration in seconds. Required without reference audio; otherwise defaults to the valid reference duration.",
        "zh": "输出时长（秒，正数）。无参考音频时必填；否则默认为有效参考时长。"
      },
      "num_inference_steps": {
        "en": "Euler sampling steps for AuK base; AuK-Flash always uses its fixed four-step schedule.",
        "zh": "AuK base 的 Euler 采样步数；AuK-Flash 固定使用其四步调度。"
      },
      "guidance_scale": {
        "en": "Batched guidance strength for AuK base; AuK-Flash always disables classifier-free guidance.",
        "zh": "AuK base 的批处理引导强度；AuK-Flash 始终关闭无分类器引导。"
      },
      "seed": {
        "en": "Nonnegative noise seed, or -1 for a random seed.",
        "zh": "非负噪声随机种子；-1 表示随机。"
      },
      "sway_sampling_coef": {
        "en": "Sway coefficient for AuK base; ignored by AuK-Flash.",
        "zh": "AuK base 的 Sway Sampling 系数；AuK-Flash 忽略该参数。"
      }
    }
  },
