{
  "family": "ace_step",
  "display_name": "ACE-Step",
  "description": "Open-source ACE-Step 1.5 music generation model for text-to-music and lyrics-to-song workflows across 50+ languages, with editing routes such as cover generation, repainting, continuation, stem extraction, and vocal-to-BGM conversion.",
  "category": "audio_generation",
  "status": "supported",
  "tasks": [
    "music",
    "edit"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "50+ languages"
  ],
  "capabilities": {
    "music": [
      "lyrics"
    ],
    "edit": [
      "prompt_editing"
    ]
  },
  "options": {
    "request": [
      {
        "name": "route",
        "type": "enum",
        "description": "ACE-Step operation; also exposed as --task-route.",
        "values": [
          "text2music",
          "complete",
          "lego",
          "extract",
          "cover",
          "cover-nofsq",
          "repaint"
        ]
      },
      {
        "name": "lyrics",
        "type": "string",
        "description": "Vocal lyrics."
      },
      {
        "name": "duration_seconds",
        "type": "float",
        "description": "Target duration; also exposed as --duration-seconds."
      },
      {
        "name": "language",
        "type": "string",
        "description": "Vocal language for lyrics; also exposed as --language."
      },
      {
        "name": "track_name",
        "type": "string",
        "description": "Track name used by lego and extract routes; also exposed as --track-name."
      },
      {
        "name": "complete_track_classes",
        "type": "string",
        "description": "Track classes for complete route."
      },
      {
        "name": "repainting_start",
        "type": "float",
        "description": "Start time for repaint route; also exposed as --repaint-start."
      },
      {
        "name": "repainting_end",
        "type": "float",
        "description": "End time for repaint route; also exposed as --repaint-end."
      },
      {
        "name": "repaint_mode",
        "type": "enum",
        "description": "Preset repaint blending policy; also exposed as --repaint-mode.",
        "values": [
          "balanced",
          "conservative",
          "aggressive"
        ]
      },
      {
        "name": "repaint_strength",
        "type": "float",
        "description": "Repaint strength; also exposed as --repaint-strength.",
        "min": 0.0,
        "max": 1.0
      },
      {
        "name": "num_inference_steps",
        "type": "int",
        "description": "Diffusion denoising steps; also exposed as --num-inference-steps."
      },
      {
        "name": "guidance_scale",
        "type": "float",
        "description": "Diffusion guidance scale; also exposed as --guidance-scale."
      },
      {
        "name": "seed",
        "type": "int",
        "description": "Generation seed; also exposed as --seed."
      },
      {
        "name": "bpm",
        "type": "int",
        "description": "Force BPM metadata."
      },
      {
        "name": "keyscale",
        "type": "string",
        "description": "Force key metadata."
      },
      {
        "name": "timesignature",
        "type": "string",
        "description": "Force time signature metadata."
      },
      {
        "name": "negative_prompt",
        "type": "string",
        "description": "Negative prompt."
      },
      {
        "name": "audio_codes",
        "type": "string",
        "description": "Use supplied ACE semantic code text instead of planner generation."
      },
      {
        "name": "audio_cover_strength",
        "type": "float",
        "description": "Cover strength for cover/edit-style conditioning.",
        "default": 1.0
      },
      {
        "name": "cover_noise_strength",
        "type": "float",
        "description": "Noise strength for cover conditioning.",
        "default": 0.0
      },
      {
        "name": "lm_temperature",
        "type": "float",
        "description": "Planner sampling temperature.",
        "default": 0.85
      },
      {
        "name": "lm_cfg_scale",
        "type": "float",
        "description": "Planner CFG scale.",
        "default": 2.0
      },
      {
        "name": "lm_top_k",
        "type": "int",
        "description": "Planner top-k; 0 disables top-k.",
        "default": 0
      },
      {
        "name": "lm_top_p",
        "type": "float",
        "description": "Planner top-p.",
        "default": 0.9
      },
      {
        "name": "lm_repetition_penalty",
        "type": "float",
        "description": "Planner repetition penalty.",
        "default": 1.0
      },
      {
        "name": "sampler_mode",
        "type": "enum",
        "description": "Diffusion sampler mode.",
        "values": [
          "euler",
          "heun"
        ],
        "default": "euler"
      },
      {
        "name": "retake_seed",
        "type": "int",
        "description": "Optional retake noise seed; -1 clears it."
      },
      {
        "name": "retake_variance",
        "type": "float",
        "description": "Retake noise mixing strength.",
        "default": 0.0
      }
    ]
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "ui": {
    "recommended_package": "ace_step_turbo_bf16",
    "tags": [
      "Music",
      "Edit",
      "GGUF"
    ],
    "docs": [
      "docs/models/ace_step.md",
      "docs/music_generation.md",
      "docs/gguf.md"
    ]
  },
