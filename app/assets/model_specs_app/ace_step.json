{
  "family": "ace_step",
  "i18n": {
    "description": {
      "en": "Open-source ACE-Step 1.5 music generation model for text-to-music and lyrics-to-song workflows across 50+ languages, with editing routes such as cover generation, repainting, continuation, stem extraction, and vocal-to-BGM conversion.",
      "zh": "开源 ACE-Step 1.5 音乐生成模型，支持 50+ 语言的文本生音乐与歌词生歌，并提供翻唱生成、重绘、续写、分轨提取、人声转伴奏等编辑路径。"
    },
    "options": {
      "route": {
        "en": "Generation or editing route.",
        "zh": "生成或编辑路线。"
      },
      "lyrics": {
        "en": "Vocal lyrics.",
        "zh": "演唱歌词。"
      },
      "language": {
        "en": "Vocal language; falls back to text input language, then en.",
        "zh": "演唱语言；回退到文本输入语言，再回退 en。"
      },
      "track_name": {
        "en": "Target track for lego or extract.",
        "zh": "lego 或 extract 的目标轨道。"
      },
      "complete_track_classes": {
        "en": "Track class or JSON array of classes for complete.",
        "zh": "complete 的轨道类别或类别 JSON 数组。"
      },
      "repainting_start": {
        "en": "Repaint start in seconds; required by repaint route.",
        "zh": "重绘开始秒数；repaint 路线必填。"
      },
      "repainting_end": {
        "en": "Repaint end in seconds; required by repaint route.",
        "zh": "重绘结束秒数；repaint 路线必填。"
      },
      "repaint_mode": {
        "en": "Repaint blend preset; balanced when only strength is supplied.",
        "zh": "重绘混合预设；仅提供 strength 时使用 balanced。"
      },
      "repaint_strength": {
        "en": "Balanced repaint strength, clamped to 0..1; default 0.5 when a preset is supplied.",
        "zh": "balanced 重绘强度，限制在 0..1；提供预设时默认 0.5。"
      },
      "num_inference_steps": {
        "en": "Denoising steps; turbo checkpoints cap this at 8.",
        "zh": "去噪步数；turbo 检查点最多 8。"
      },
      "guidance_scale": {
        "en": "Diffusion CFG; default 1, or 7 for extract. Ignored by turbo checkpoints.",
        "zh": "扩散 CFG；默认 1，extract 为 7；turbo 检查点忽略。"
      },
      "seed": {
        "en": "Unsigned 32-bit generation seed; random when omitted.",
        "zh": "无符号 32 位生成种子；省略时随机。"
      },
      "bpm": {
        "en": "Override planner BPM metadata.",
        "zh": "覆盖规划器 BPM 元数据。"
      },
      "keyscale": {
        "en": "Override planner musical key metadata.",
        "zh": "覆盖规划器调性元数据。"
      },
      "timesignature": {
        "en": "Override planner time signature metadata.",
        "zh": "覆盖规划器拍号元数据。"
      },
      "negative_prompt": {
        "en": "Negative prompt.",
        "zh": "负向提示。"
      },
      "audio_codes": {
        "en": "ACE semantic code text to bypass planner generation.",
        "zh": "ACE 语义 code 文本，用于跳过规划器生成。"
      },
      "audio_cover_strength": {
        "en": "Cover conditioning strength.",
        "zh": "翻唱条件强度。"
      },
      "cover_noise_strength": {
        "en": "Cover conditioning noise strength.",
        "zh": "翻唱条件噪声强度。"
      },
      "lm_temperature": {
        "en": "Planner sampling temperature.",
        "zh": "规划器采样温度。"
      },
      "lm_top_k": {
        "en": "Planner top-k; 0 disables it.",
        "zh": "规划器 top-k；0 关闭。"
      },
      "lm_top_p": {
        "en": "Planner nucleus sampling threshold.",
        "zh": "规划器核采样阈值。"
      },
      "lm_repetition_penalty": {
        "en": "Planner repetition penalty.",
        "zh": "规划器重复惩罚。"
      },
      "sampler_mode": {
        "en": "Diffusion sampler.",
        "zh": "扩散采样器。"
      },
      "retake_seed": {
        "en": "Optional retake seed; -1 clears it.",
        "zh": "可选重录种子；-1 清除。"
      },
      "retake_variance": {
        "en": "Retake noise mixing strength.",
        "zh": "重录噪声混合强度。"
      },
      "duration_sec": {
        "en": "Target seconds; non-positive lets the planner choose. Source-locked routes use source duration.",
        "zh": "目标时长（秒）；非正值由规划器决定。锁定源音频的路线使用源时长。"
      },
      "shift": {
        "en": "Diffusion schedule shift; default 1, or 3 for extract.",
        "zh": "扩散时间步调度偏移；默认 1，extract 模式为 3。"
      },
      "enable_thinking": {
        "en": "Enable planner thinking where the route and checkpoint support it.",
        "zh": "在路线和检查点支持时启用规划器思考。"
      },
      "lm_guidance_scale": {
        "en": "Planner CFG, independent of diffusion guidance.",
        "zh": "规划器 CFG，独立于扩散引导。"
      }
    }
  },
