  "i18n": {
    "description": {
      "en": "NVIDIA MagpieTTS is a multilingual neural text-to-speech model that generates NanoCodec audio tokens from text using baked speaker context embeddings, a decoder-only transformer, and an autoregressive local transformer before decoding the tokens to waveform audio.",
      "zh": "NVIDIA MagpieTTS 是多语言神经文本转语音模型，使用烘焙的说话人上下文嵌入、仅解码器 Transformer 与自回归局部 Transformer 从文本生成 NanoCodec 音频 token，再解码为波形。"
    },
    "options": {
      "language": {
        "en": "Target synthesis language code used by the Magpie text frontend; default en.",
        "zh": "Magpie 文本前端使用的目标合成语言代码；默认 en。"
      },
      "voice_id": {
        "en": "Packaged MagpieTTS voice name; default Aria.",
        "zh": "打包的 MagpieTTS 音色名称；默认 Aria。"
      },
      "temperature": {
        "en": "Autoregressive audio-token sampling temperature; default 0.6 from the v2607 model config.",
        "zh": "自回归音频 token 采样温度；默认 0.6，取自 v2607 模型配置。"
      },
      "top_k": {
        "en": "Autoregressive audio-token top-k sampling limit; default 80.",
        "zh": "自回归音频 token 的 top-k 采样上限；默认 80。"
      },
      "guidance_scale": {
        "en": "Classifier-free guidance scale for Magpie decoder logits; default 2.5.",
        "zh": "作用于 Magpie 解码器 logits 的无分类器引导强度；默认 2.5。"
      },
      "max_tokens": {
        "en": "Maximum Magpie decoder frames per text segment; default 500 from the v2607 model config.",
        "zh": "每个文本分段最多生成的 Magpie 解码器帧数；默认 500，取自 v2607 模型配置。"
      },
      "seed": {
        "en": "Seed for audio-token sampling; default 0.",
        "zh": "音频 token 采样的随机种子；默认 0。"
      }
    }
  }
