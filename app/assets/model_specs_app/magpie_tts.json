        "min": 0.0,
        "default": 0.6
      },
      {
        "name": "top_k",
        "type": "int",
        "description": "Autoregressive audio-token top-k sampling limit; default 80.",
        "required": false,
        "min": 1,
        "default": 80
      },
      {
        "name": "guidance_scale",
        "type": "float",
        "description": "Classifier-free guidance scale for Magpie decoder logits; default 2.5.",
        "required": false,
        "min": 0.0,
        "default": 2.5
      },
      {
        "name": "max_tokens",
        "type": "int",
        "description": "Maximum Magpie decoder frames per text segment; default 500 from the v2607 model config.",
        "required": false,
        "min": 1,
        "default": 500
      },
      {
        "name": "seed",
        "type": "int",
        "description": "Seed for audio-token sampling; default 0.",
        "required": false,
        "min": 0,
        "default": 0
      }
    ],
    "session": [
      {
        "name": "graph_arena_mb",
        "type": "int",
        "description": "Reusable ggml graph arena size in MiB for Magpie stages; default 1024.",
        "required": false,
        "min": 1,
        "default": 1024
      },
      {
        "name": "weight_context_mb",
        "type": "int",
        "description": "Weight loading context size in MiB; default 2048.",
        "required": false,
        "min": 1,
        "default": 2048
      },
      {
        "name": "weight_type",
        "type": "enum",
        "description": "Matmul weight storage type; default native.",
        "preset": "weight_type_full",
        "required": false,
        "default": "native"
      },
      {
        "name": "conv_weight_type",
        "type": "enum",
        "description": "Convolution weight storage type; default native.",
        "preset": "weight_type_conv",
        "required": false,
        "default": "native"
      }
