{
  "family": "kitten_tts2",
  "i18n": {
    "description": {
      "en": "Native multilingual Kitten TTS 2 Qwen3 speech generation, S3 meanflow decoder, and reference-audio voice cloning.",
      "zh": "原生多语言 Kitten TTS 2：Qwen3 语音生成、S3 MeanFlow 解码器，支持参考音频音色克隆。"
    },
    "options": {
      "voice_id": {
        "en": "Prepared voice name available in the loaded package. A supplied reference clip takes precedence.",
        "zh": "已加载包中可用的预置音色名称。提供参考音频时优先使用参考音频。"
      },
      "preset": {
        "en": "Upstream sampling preset.",
        "zh": "上游采样预设。"
      },
      "temperature": {
        "en": "Sampling temperature; zero selects greedy decoding. Otherwise defaults to the preset.",
        "zh": "采样温度；0 表示贪心解码，否则使用预设默认值。"
      },
      "top_k": {
        "en": "Top-k sampling cutoff; defaults to the preset.",
        "zh": "top-k 采样截断；默认使用预设值。"
      },
      "top_p": {
        "en": "Nucleus sampling cutoff; defaults to the preset. Must be in (0, 1].",
        "zh": "核采样截断；默认使用预设值，必须在 (0, 1] 内。"
      },
      "min_p": {
        "en": "Minimum relative probability; defaults to the preset.",
        "zh": "最小相对概率；默认使用预设值。"
      },
      "repetition_penalty": {
        "en": "Penalty over the last 50 generated tokens; silence and ending tokens are exempt.",
        "zh": "对最近 50 个生成 token 的重复惩罚；静音与结束 token 豁免。"
      },
      "max_tokens": {
        "en": "Speech-token budget per text chunk. Omitted budgets scale with text length, with a minimum of 200.",
        "zh": "每个文本分块的语音 token 预算。省略时按文本长度缩放，最小 200。"
      },
      "seed": {
        "en": "Seed for sampling and waveform decoding.",
        "zh": "采样与波形解码的随机种子。"
      },
      "text_chunk_size": {
        "en": "Maximum Unicode codepoints per framework text chunk.",
        "zh": "框架文本分块的最大 Unicode 码点数。"
      },
      "text_chunk_mode": {
        "en": "Framework long-form text chunking mode.",
        "zh": "框架长文本分块模式。"
      },
      "reference_text": {
        "en": "Transcript of the reference audio; required when cloning from a 1–30 second clip.",
        "zh": "参考音频对应的文本；从 1–30 秒片段克隆时必填。"
      }
    }
  },
