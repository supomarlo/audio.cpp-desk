  "i18n": {
    "description": {
      "en": "Fun-CosyVoice3 native GGUF package for zero-shot, cross-lingual, and instruction-conditioned text-to-speech using CosyVoice3 speech-token AR generation, causal masked flow mel decoding, CAM++ speaker conditioning, and causal HiFT waveform decoding.",
      "zh": "Fun-CosyVoice3 原生 GGUF 包，采用 CosyVoice3 语音 token 自回归生成、因果掩码流式 mel 解码、CAM++ 说话人条件与因果 HiFT 波形解码，支持零样本、跨语言与指令条件文本转语音。"
    },
    "options": {
      "template_name": {
        "en": "CosyVoice3 request template.",
        "zh": "CosyVoice3 请求模板。"
      },
      "reference_text": {
        "en": "Transcript for the prompt audio.",
        "zh": "提示音频对应的文本。"
      },
      "max_tokens": {
        "en": "Maximum generated speech tokens; -1 (default) selects 20 times the target text token count. Explicit limits must be positive.",
        "zh": "生成语音 token 上限；-1（默认）表示目标文本 token 数的 20 倍。显式上限必须为正。"
      },
      "min_tokens": {
        "en": "Minimum generated speech tokens before stop is accepted; -1 (default) selects twice the target text token count. Must not exceed the resolved maximum.",
        "zh": "接受停止前的最小生成语音 token 数；-1（默认）表示目标文本 token 数的 2 倍。不得超过解析后的最大值。"
      },
      "top_k": {
        "en": "AR speech-token top-k sampling limit; default 25.",
        "zh": "AR 语音 token 的 top-k 采样上限，默认 25。"
      },
      "num_inference_steps": {
        "en": "Flow decoder Euler steps; default 10.",
        "zh": "流解码器 Euler 步数，默认 10。"
      },
      "seed": {
        "en": "Generation seed.",
        "zh": "生成随机种子。"
      },
      "instruct": {
        "en": "Instruction text for instruct mode.",
        "zh": "instruct 模式的指令文本。"
      },
      "text_chunk_size": {
        "en": "Maximum Unicode codepoints per long-form text chunk; default 600.",
        "zh": "长文本分块的最大 Unicode 码点数；默认 600。"
      },
      "text_chunk_mode": {
        "en": "Framework text chunking mode.",
        "zh": "框架文本分块模式。"
      }
    }
