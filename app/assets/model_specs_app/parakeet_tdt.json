{
  "family": "parakeet_tdt",
  "i18n": {
    "description": {
      "en": "NVIDIA Parakeet-TDT 0.6B v3 FastConformer-TDT ASR covering 25 European languages with automatic language detection. Supports the upstream Transformers-compatible safetensors package and standalone audio.cpp GGUF, with offline full-context, bounded-window long-form, and buffered streaming; the checkpoint uses unlimited bidirectional attention and is not a native cache-aware streaming model.",
      "zh": "NVIDIA Parakeet-TDT 0.6B v3 FastConformer-TDT ASR，覆盖 25 种欧洲语言并自动检测语言。支持上游 Transformers 兼容的 safetensors 包与独立 audio.cpp GGUF，具备离线全上下文、有界窗口长音频与缓冲式流式；该检查点使用无界双向注意力，并非原生 cache-aware 流式模型。"
    },
    "options": {
      "max_tokens": {
        "en": "Maximum TDT generated tokens; 0 or omitted uses the model-derived limit.",
        "zh": "TDT 最多生成的 token 数；为 0 或省略时使用按模型推算的上限。"
      },
      "audio_chunk_mode": {
        "en": "Offline audio chunking mode. vad uses the configured VAD model (Silero by default) to skip silence; auto keeps Parakeet's existing offline_mode behavior.",
        "zh": "离线音频分块模式。 vad 使用配置的 VAD 模型（默认为 Silero）来跳过静默； auto 保留Parakeet 现有的offline_mode 行为。"
      },
      "audio_chunk_duration_sec": {
        "en": "VAD maximum chunk duration; omitted inherits the session duration. Fixed/long_form windows use the session setting, not this request override.",
        "zh": "VAD最大块持续时间；省略继承会话持续时间。固定/长格式窗口使用会话设置，而不是此请求覆盖。"
      },
      "return_timestamps": {
        "en": "Accepted for CLI --words-out compatibility. Word timestamps are always returned, including when false or omitted.",
        "zh": "为兼容 CLI --words-out 而接受；词级时间戳始终返回，即使为 false 或省略。"
      },
      "keep_language_tags": {
        "en": "Keep language tag tokens in decoded text; default false.",
        "zh": "在解码文本中保留语言标签 token；默认 false。"
      },
      "hotwords": {
        "en": "Phonon-2 only: optional vocabulary list, comma-separated or a JSON array of strings / word-spoken objects. Up to 25 terms; an explicit empty list disables prompt biasing.",
        "zh": "仅 Phonon-2：可选词表，逗号分隔或 JSON 字符串/word-spoken 对象数组。最多 25 个词；显式空列表关闭提示偏置。"
      },
      "hotwords_score": {
        "en": "Phonon-2 matching-piece logit bonus; duration scores and blank are not biased.",
        "zh": "Phonon-2 匹配片段 logit 加分；时长分数与 blank 不加权。"
      }
    }
  },
