{
  "family": "fish_drama3",
  "i18n": {
    "description": {
      "en": "Fish Audio Drama 3 native MoE speech generation, voice cloning, and continuation.",
      "zh": "Fish Audio Drama 3 原生 MoE 语音生成、音色克隆与续写。"
    },
    "options": {
      "encode_reference_only": {
        "en": "Prepare reference VQ codes without generating speech. Use the task API to receive drama3_reference_v1 acoustic-token artifacts.",
        "zh": "仅准备参考 VQ 编码，不生成语音。通过 task API 获取 drama3_reference_v1 声学 token 产物。"
      },
      "reference_text": {
        "en": "Transcript of inline reference audio.",
        "zh": "行内参考音频对应的文本。"
      },
      "multi_reference_cond": {
        "en": "Ordered references as JSON: [{text, audio_path or vq_codes}]. Speaker tags 0..15 select voices.",
        "zh": "按顺序排列的参考 JSON：[{text, audio_path 或 vq_codes}]。说话人标签 0..15 用于选择音色。"
      },
      "references": {
        "en": "Alias of multi_reference_cond.",
        "zh": "multi_reference_cond 的别名。"
      },
      "previous_takes": {
        "en": "Continuation/edit history as a JSON array of {text, vq_codes or audio_path}; a string generates that earlier take first.",
        "zh": "续写/编辑历史，JSON 数组 {text, vq_codes 或 audio_path}；字符串会先生成该历史 take。"
      },
      "previous_takes_file": {
        "en": "JSON history file containing a take object or an ordered array of earlier takes. Avoids the Windows command-line length limit for VQ grids.",
        "zh": "包含 take 对象或有序历史数组的 JSON 文件；用于避免 Windows 命令行长度限制。"
      },
      "max_tokens": {
        "en": "Maximum generated acoustic frames per text chunk (about 21.5 frames/second).",
        "zh": "每个文本分块生成的最大声学帧数（约 21.5 帧/秒）。"
      },
      "text_chunk_size": {
        "en": "Maximum characters per long-form chunk.",
        "zh": "长文本分块的最大字符数。"
      },
      "text_chunk_mode": {
        "en": "Framework text chunking mode.",
        "zh": "框架文本分块模式。"
      },
      "temperature": {
        "en": "Main and residual sampling temperature. Zero makes the initial draws greedy; semantic repeat redraws retain the fixed Drama 3 RAS settings.",
        "zh": "主采样与残差采样温度。0 使初始采样为贪心；语义重复重采样仍使用固定的 Drama 3 RAS 设置。"
      },
      "top_p": {
        "en": "Inclusive nucleus cutoff before top-k filtering, matching Drama 3.",
        "zh": "top-k 过滤前的包含式核采样阈值，与 Drama 3 一致。"
      },
      "top_k": {
        "en": "Top-k candidate count. The default 4097 keeps every candidate (no cap), as Fish's Drama 3 Space does; 30 can stall in long silences.",
        "zh": "top-k 候选数量。默认 4097 保留全部候选（不设上限），与 Fish Drama 3 Space 一致；30 可能在长静音处卡住。"
      },
      "seed": {
        "en": "Reproducible native sampling seed.",
        "zh": "可复现的原生采样随机种子。"
      }
    }
  },
