{
  "family": "vevo2",
  "display_name": "Vevo2",
  "description": "Unified controllable framework for English and Chinese speech and singing voice generation, voice conversion, and editing, with tokenizers that disentangle content, prosody, melody, style, and timbre.",
  "category": "voice_conversion",
  "status": "supported",
  "tasks": [
    "tts",
    "music",
    "vc",
    "edit",
    "svc",
    "s2s"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "en",
    "zh"
  ],
  "capabilities": {
    "music": [
      "lyrics"
    ],
    "vc": [
      "speaker_reference"
    ],
    "svc": [
      "speaker_reference",
      "singing"
    ],
    "s2s": [
      "speaker_reference"
    ],
    "edit": [
      "prompt_editing"
    ]
  },
  "options": {
    "request": [
      {
        "name": "route",
        "type": "enum",
        "description": "VeVo2 route: zero_shot_tts, text_to_singing, svs, style_preserved_vc, style_preserved_svc, style_converted_vc, style_converted_svc, editing, singing_style_conversion, humming_to_singing, or instrument_to_singing",
        "values": [
          "zero_shot_tts",
          "text_to_singing",
          "svs",
          "style_preserved_vc",
          "style_preserved_svc",
          "style_converted_vc",
          "style_converted_svc",
          "editing",
          "singing_style_conversion",
          "humming_to_singing",
          "instrument_to_singing"
        ]
      },
      {
        "name": "source_audio",
        "type": "path",
        "description": "Source speech or singing audio for conversion/editing routes."
      },
      {
        "name": "target_voice",
        "type": "path",
        "description": "Target timbre reference audio."
      },
      {
        "name": "prosody_ref",
        "type": "path",
        "description": "Prosody or melody reference audio."
      },
      {
        "name": "style_ref",
        "type": "path",
        "description": "Style reference audio."
      },
      {
        "name": "target_text",
        "type": "string",
        "description": "Text or lyrics to vocalize."
      },
      {
        "name": "style_ref_text",
        "type": "string",
        "description": "Transcript for the style reference when text conditioning is used."
      },
      {
        "name": "use_prosody_code",
        "type": "bool",
        "description": "Enable explicit prosody-code conditioning."
      },
      {
        "name": "predict_target_prosody",
        "type": "bool",
        "description": "Predict target prosody during AR generation."
      },
      {
        "name": "use_pitch_shift",
        "type": "bool",
        "description": "Pitch-align source/prosody/style references to the target voice."
      },
      {
        "name": "source_shift_steps",
        "type": "int",
        "description": "Manual pitch-shift semitone steps for source audio."
      },
      {
        "name": "prosody_shift_steps",
        "type": "int",
        "description": "Manual pitch-shift semitone steps for prosody reference audio."
      },
      {
        "name": "style_shift_steps",
        "type": "int",
        "description": "Manual pitch-shift semitone steps for style reference audio."
      },
      {
        "name": "target_duration_seconds",
        "type": "float",
        "description": "Target output duration hint for flow matching."
      },
      {
        "name": "reference_duration_seconds",
        "type": "float",
        "description": "Trim target voice reference duration before conditioning."
      },
      {
        "name": "temperature",
        "type": "float",
        "description": "AR sampling temperature."
      },
      {
        "name": "top_k",
        "type": "int",
        "description": "AR top-k sampling limit."
      },
      {
        "name": "top_p",
        "type": "float",
        "description": "AR nucleus sampling threshold."
      },
      {
        "name": "repetition_penalty",
        "type": "float",
        "description": "AR repetition penalty."
      },
      {
        "name": "max_tokens",
        "type": "int",
        "description": "Maximum generated AR content/style tokens."
      },
      {
        "name": "num_inference_steps",
        "type": "int",
        "description": "Flow-matching denoising steps."
      },
      {
        "name": "seed",
        "type": "int",
        "description": "Request seed; omitted means random."
      },
      {
        "name": "audio_chunk_duration_sec",
        "type": "float",
        "description": "Opt-in source-audio chunking for style_preserved_vc and style_preserved_svc. 0 keeps the existing one-shot path.",
        "default": 0.0
      },
      {
        "name": "cross_fade_duration_sec",
        "type": "float",
        "description": "Source chunk overlap and output crossfade duration when source-audio chunking is enabled. Must be smaller than audio_chunk_duration_sec."
      }
    ]
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "ui": {
    "recommended_package": "vevo2_q8_0",
    "tags": [
      "TTS",
      "Music",
      "VC",
      "Edit",
      "GGUF"
    ],
    "docs": [
      "docs/models/vevo2.md",
      "docs/tts.md",
      "docs/gguf.md"
    ]
  },
