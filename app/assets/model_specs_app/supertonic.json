    },
    "options": {
      "voice_id": {
        "en": "Built-in voice preset; --voice-id takes precedence.",
        "zh": "内置语音预设； --voice-id 优先。"
      },
      "num_inference_steps": {
        "en": "Flow denoising steps.",
        "zh": "流程去噪步骤。"
      },
      "speed": {
        "en": "Positive speech speed multiplier; voice.style.speaking_rate takes precedence.",
        "zh": "正语音速度倍增器； voice.style.speaking_rate 优先。"
      },
      "seed": {
        "en": "Noise seed.",
        "zh": "噪声种子。"
      },
      "text_chunk_size": {
        "en": "Framework text chunk size; defaults to 120 for Korean/Japanese, otherwise 300.",
        "zh": "框架文本分块大小；韩语/日语默认 120，其它 300。"
      },
      "text_chunk_mode": {
        "en": "Framework text chunking mode.",
        "zh": "框架文本分块模式。"
      }
    }
