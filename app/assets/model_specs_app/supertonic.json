  "options": {
    "request": [
      {
        "name": "voice_id",
        "type": "enum",
        "description": "Preset voice style id, default M1; also exposed as --voice-id.",
        "values": [
          "M1",
          "M2",
          "M3",
          "M4",
          "M5",
          "F1",
          "F2",
          "F3",
          "F4",
          "F5"
        ]
      },
      {
        "name": "num_inference_steps",
        "type": "int",
        "description": "Flow denoising steps, default 8."
      },
      {
        "name": "speed",
        "type": "float",
        "description": "Speech speed multiplier, default 1.05."
      },
      {
        "name": "speaking_rate",
        "type": "float",
        "description": "Alias for speed."
      },
      {
        "name": "seed",
        "type": "int",
        "description": "Noise seed, default 1234."
      }
    ]
  },
  "runtime": {
    "tags": [
      "gguf",
      "stream"
    ]
  },
  "ui": {
    "recommended_package": "supertonic_3_orig",
