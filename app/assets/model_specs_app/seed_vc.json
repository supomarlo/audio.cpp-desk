{
  "family": "seed_vc",
  "i18n": {
    "description": {
      "en": "Zero-shot voice conversion and singing voice conversion model for transferring timbre and style from reference audio, with low-latency realtime conversion and optional lightweight fine-tuning.",
      "zh": "零样本音色转换与歌声转换模型，可从参考音频迁移音色与风格，支持低延迟实时转换与可选的轻量微调。"
    },
    "options": {
      "route": {
        "en": "Select the Seed-VC conversion route. Defaults to v2_vc for VC and v1_svc for SVC.",
        "zh": "选择 Seed-VC 的转换路线。VC 默认 v2_vc，SVC 默认 v1_svc。"
      },
      "num_inference_steps": {
        "en": "Diffusion steps; default 30.",
        "zh": "扩散步数；默认 30。"
      },
      "inference_guidance_scale": {
        "en": "V1 classifier-free guidance scale; default 0.7. Any finite value is accepted; V1 disables CFG for nonpositive values.",
        "zh": "V1无分类器指导量表；默认 0.7。接受任何有限值； V1 对非正值禁用 CFG。"
      },
      "intelligibility_guidance_scale": {
        "en": "V2 classifier-free guidance scale for source-content intelligibility; default 0.7. Any finite value is accepted and used in V2 guidance arithmetic.",
        "zh": "V2 无分类器源内容清晰度指导量表；默认 0.7。 V2 制导算法中接受并使用任何有限值。"
      },
      "similarity_guidance_scale": {
        "en": "V2 classifier-free guidance scale for target-speaker similarity; default 0.7. Any finite value is accepted and used in V2 guidance arithmetic.",
        "zh": "针对目标说话人相似度的 V2 无分类器指导量表；默认 0.7。 V2 制导算法中接受并使用任何有限值。"
      },
      "voice_anonymization": {
        "en": "Use randomized average-voice conditioning instead of target-speaker conditioning for V2 anonymization; default false.",
        "zh": "V2 匿名化时使用随机平均音色条件而非目标说话人条件；默认 false。"
      },
      "seed": {
        "en": "Seed for V1/V2 diffusion noise and HiFT stochastic source excitation; omitted requests choose a random seed.",
        "zh": "V1/V2 扩散噪声与 HiFT 随机源激励的随机种子；省略时随机。"
      },
      "f0_condition": {
        "en": "Enable V1 F0 conditioning. Defaults to true for v1_svc and false for the V1 voice-conversion routes.",
        "zh": "启用 V1 F0 调节。对于 v1_svc，默认值为 true；对于 V1 语音转换路由，默认值为 false。"
      },
      "auto_f0_adjust": {
        "en": "Automatically adjust V1 source pitch toward the target pitch level; default false.",
        "zh": "自动把 V1 源音高调整到目标音高水平；默认 false。"
      },
      "semitone_shift": {
        "en": "V1 pitch shift in semitones for singing voice conversion; default 0.",
        "zh": "歌声转换中 V1 的半音移调；默认 0。"
      },
      "duration_scale": {
        "en": "V1 output duration multiplier; must be finite and positive, default 1.0. V2 validates this option but does not apply it.",
        "zh": "V1 输出时长倍率；必须为有限正数，默认 1.0。V2 会校验该选项但不应用。"
      },
      "noise_file": {
        "en": "Optional raw f32 noise file for deterministic V1/V2 diffusion noise and XLSR/HiFT source excitation.",
        "zh": "可选的原始 f32 噪声文件，用于确定性的 V1/V2 扩散噪声与 XLSR/HiFT 源激励。"
      }
    }
  },
