{
  "family": "latentsync",
  "i18n": {
    "description": {
      "en": "Audio-conditioned lip synchronization of a reference video.",
      "zh": "对参考视频进行音频驱动的唇形同步。"
    },
    "options": {
      "reference_video_file": {
        "en": "Reference video containing the face to synchronize. Requires FFmpeg on PATH.",
        "zh": "包含待同步人脸的参考视频；需要 PATH 中有 FFmpeg。"
      },
      "num_inference_steps": {
        "en": "Number of DDIM denoising steps.",
        "zh": "DDIM 去噪步数。"
      },
      "cache_interval": {
        "en": "DeepCache refresh interval. One disables caching; three matches the upstream DeepCache preset. Higher values trade output fidelity for speed.",
        "zh": "DeepCache 刷新间隔。1 关闭缓存；3 对应上游 DeepCache 预设；更高值以保真度换取速度。"
      },
      "guidance_scale": {
        "en": "Audio classifier-free guidance scale; values at or below one disable CFG.",
        "zh": "音频无分类器引导强度；小于等于 1 时关闭 CFG。"
      },
      "frames_per_chunk": {
        "en": "Frames processed together by the temporal denoiser.",
        "zh": "时间去噪器一次处理的帧数。"
      },
      "fps": {
        "en": "Video sampling and output frame rate.",
        "zh": "视频采样与输出帧率。"
      },
      "seed": {
        "en": "Random seed for latent noise and VAE posterior sampling.",
        "zh": "latent 噪声与 VAE 后验采样的随机种子。"
      }
    }
  },
