{
  "family": "sortformer_diar",
  "i18n": {
    "description": {
      "en": "NVIDIA Transformer-based end-to-end speaker diarization model trained primarily on English speech, predicting speaker labels directly from audio and resolving speaker ordering by arrival time for up to four speakers.",
      "zh": "NVIDIA 基于 Transformer 的端到端说话人日志模型，主要在英语语音上训练，直接从音频预测说话人标签，并按到达时间确定最多四位说话人的顺序。"
    },
    "options": {
      "speaker_threshold": {
        "en": "Speaker activity probability threshold used when decoding speaker turns; default 0.5.",
        "zh": "解码说话人轮次时使用的说话人活动概率阈值；默认 0.5。"
      },
      "speaker_min_frames": {
        "en": "Minimum decoded segment length in model output frames; default 0 disables short-segment filtering.",
        "zh": "模型输出帧下的最短解码片段长度；默认 0 关闭短片段过滤。"
      },
      "speaker_pad_frames": {
        "en": "Pad each decoded speaker segment by this many model output frames before filtering and merging; default 0.",
        "zh": "在过滤与合并前，为每个解码说话人片段填充的模型输出帧数；默认 0。"
      }
    }
  },
