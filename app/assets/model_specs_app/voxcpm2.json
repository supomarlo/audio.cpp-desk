{
  "family": "voxcpm2",
  "i18n": {
    "description": {
      "en": "OpenBMB tokenizer-free TTS model supporting 30 languages and 9 Chinese dialects, with 48 kHz output, natural-language voice design, controllable short-reference voice cloning, and expressive style guidance.",
      "zh": "OpenBMB 无分词器 TTS 模型，支持 30 种语言与 9 种中文方言，48 kHz 输出、自然语言声音设计、可控短参考音色克隆与表现力风格引导。"
    },
    "options": {
      "seed": {
        "en": "Sampling seed.",
        "zh": "取样种子。"
      },
      "max_tokens": {
        "en": "Maximum generated audio tokens. Zero resolves to model max_length; requires min_tokens <= resolved max_tokens <= model limit.",
        "zh": "生成的最大音频令牌。零解析为模型 max_length；要求 min_tokens <= 已解析的 max_tokens <= 模型限制。"
      },
      "min_tokens": {
        "en": "Minimum generated audio tokens.",
        "zh": "生成的最小音频令牌。"
      },
      "num_inference_steps": {
        "en": "Flow sampling steps. Must be positive.",
        "zh": "流量采样步骤。必须是积极的。"
      },
      "guidance_scale": {
        "en": "Classifier-free guidance scale. Must be nonnegative.",
        "zh": "无分类器指导量表。必须是非负的。"
      },
      "prompt_text": {
        "en": "Transcript for continuation prompt audio, distinct from the base voice reference.",
        "zh": "连续提示音频的转录，与基本语音参考不同。"
      },
      "retry_badcase": {
        "en": "Retry detected bad generations. Offline only; streaming requires false.",
        "zh": "重试检测到的坏生成；仅离线，流式要求 false。"
      },
      "retry_badcase_max_times": {
        "en": "Total attempts including the initial attempt, not extra retries; must be positive.",
        "zh": "总尝试次数（包含首次尝试，不是额外重试次数）；必须为正。"
      },
      "retry_badcase_ratio_threshold": {
        "en": "Bad-case audio/text length ratio threshold. Must be positive.",
        "zh": "坏例音频/文本长度比阈值；必须为正。"
      },
      "cfm_noise_file": {
        "en": "Precomputed flow noise file.",
        "zh": "预计算 flow 噪声文件。"
      },
      "stream_chunk_policy": {
        "en": "Streaming decoder cadence: grow emits one patch first, then doubles toward stream_frames_per_event; fixed uses the configured size. Ignored offline.",
        "zh": "流式解码节奏：grow 先输出一个 patch，然后逐步翻倍到 stream_frames_per_event；fixed 使用配置大小；离线忽略。"
      },
      "stream_frames_per_event": {
        "en": "Maximum generated latent patches per streaming decoder event. Set to 1 for one-patch emission. Ignored offline.",
        "zh": "每个流式解码事件生成的最大 latent patch 数；设为 1 表示单 patch 输出；离线忽略。"
      },
      "stream_left_context": {
        "en": "Previous patches decoded as streaming left context.",
        "zh": "作为流式左上下文解码的先前 patch 数。"
      },
      "chunk_strategy": {
        "en": "Long-form continuation or independent generation per chunk. Offline only.",
        "zh": "按分块进行长文本续写或独立生成；仅离线。"
      },
      "text_chunk_size": {
        "en": "Framework long-form text chunk size. Offline only.",
        "zh": "框架长文本分块大小；仅离线。"
      },
      "text_chunk_mode": {
        "en": "Framework text chunking mode. Offline only.",
        "zh": "框架文本分块模式；仅离线。"
      }
    }
  },
