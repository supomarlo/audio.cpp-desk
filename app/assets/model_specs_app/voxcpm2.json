      {
        "name": "seed",
        "type": "int",
        "description": "Random seed for MiniCPM and diffusion sampling."
      },
      {
        "name": "max_tokens",
        "type": "int",
        "description": "Maximum MiniCPM output tokens."
      },
      {
        "name": "min_tokens",
        "type": "int",
        "description": "Minimum MiniCPM output tokens before an EOS stop is honored."
      },
      {
        "name": "num_inference_steps",
        "type": "int",
        "description": "CFM diffusion sampling steps."
      },
      {
        "name": "guidance_scale",
        "type": "float",
        "description": "CFM classifier-free guidance rate."
      },
      {
        "name": "prompt_text",
        "type": "string",
        "description": "Text prompt for prompt-continuation voice cloning."
      },
      {
        "name": "reference_text",
        "type": "string",
        "description": "Alias for prompt_text; text prompt for prompt-continuation voice cloning."
      }
