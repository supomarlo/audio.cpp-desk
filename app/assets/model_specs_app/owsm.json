{
  "family": "owsm",
  "i18n": {
    "description": {
      "en": "ESPnet Open Whisper-style multilingual speech recognition and speech translation.",
      "zh": "ESPnet Open Whisper 风格多语言语音识别与语音翻译。"
    },
    "options": {
      "language": {
        "en": "Input language as an OWSM ISO 639-3 code, such as eng, jpn, or zho; auto detects it from the first window.",
        "zh": "输入语言，使用 OWSM ISO 639-3 代码，如 eng、jpn、zho；auto 从第一个窗口检测。"
      },
      "target_language": {
        "en": "Optional OWSM translation target code. Omit for transcription.",
        "zh": "可选的 OWSM 翻译目标代码。转写时省略。"
      },
      "return_timestamps": {
        "en": "Return OWSM utterance-level timestamp segments.",
        "zh": "返回 OWSM 话语级时间戳片段。"
      },
      "condition_on_previous_text": {
        "en": "Condition each long-form chunk on the previous chunk transcript.",
        "zh": "长文本分块时，使每个分块以之前分块的转写为条件。"
      },
      "num_beams": {
        "en": "Decoder beam width; one selects greedy decoding.",
        "zh": "解码器 beam 宽度；1 表示贪心解码。"
      },
      "max_tokens": {
        "en": "Maximum generated tokens per 30-second window; zero uses the model limit.",
        "zh": "每个 30 秒窗口生成的最大 token 数；0 使用模型上限。"
      },
      "audio_chunk_mode": {
        "en": "Long-form audio chunking mode.",
        "zh": "长音频分块模式。"
      },
      "audio_chunk_duration_sec": {
        "en": "Maximum duration of each audio window. Must be positive.",
        "zh": "每个音频窗口的最大时长；必须为正。"
      }
    }
  },
