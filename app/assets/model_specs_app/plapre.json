  "i18n": {
    "description": {
      "en": "Danish speech synthesis with a Llama autoregressive decoder and Kanade audio codec. Streaming emits completed text chunks, not incremental codec frames.",
      "zh": "丹麦语语音合成，采用 Llama 自回归解码器与 Kanade 音频编解码器；流式模式输出完整文本块，而非增量码本帧。"
    },
    "options": {
      "voice_id": {
        "en": "Built-in speaker.",
        "zh": "内置音色。"
      },
      "reference_text": {
        "en": "Transcript of the reference audio, used for voice cloning.",
        "zh": "参考音频对应的文本，用于音色克隆。"
      },
      "x_vector_only_mode": {
        "en": "Use only the reference speaker embedding, without the reference transcript/audio-token prefix.",
        "zh": "仅使用参考说话人嵌入，不使用参考转写/音频 token 前缀。"
      },
      "word_duration_frames": {
        "en": "JSON array of per-word integer durations, from 0 to 399 frames at 25 Hz. Duration-controlled text is generated in one chunk.",
        "zh": "逐词整数时长的 JSON 数组，从 0 到 399 帧（25 Hz）。时长控制文本会在一个分块中生成。"
      },
      "context_text": {
        "en": "Previous utterance for prosodic context.",
        "zh": "用于韵律上下文的上一条话语。"
      },
      "context_audio_file": {
        "en": "Optional previous-utterance WAV accompanying context_text.",
        "zh": "可选的伴随 context_text 的上一条话语 WAV。"
      },
      "same_speaker": {
        "en": "Whether context_text belongs to the target speaker.",
        "zh": "context_text 是否属于目标说话人。"
      },
      "pronunciations": {
        "en": "Ordered JSON array of pronunciation references: [{\"word\":\"morgen\",\"audio_file\":\"morgen.wav\"}]. Up to 10 references, 60 codes each and 200 total codes are used.",
        "zh": "有序的发音参考 JSON 数组：[{\"word\":\"morgen\",\"audio_file\":\"morgen.wav\"}]。最多使用 10 条参考、每条 60 个 code、总计 200 个 code。"
      },
      "edit_start_frame": {
        "en": "Start of the masked span in voice_ref, in 25-Hz codec frames. Supply both edit boundaries and the complete desired text.",
        "zh": "voice_ref 中被遮罩片段的起始帧（25 Hz codec 帧）。需同时提供编辑边界与完整目标文本。"
      },
      "edit_end_frame": {
        "en": "Exclusive end of the masked span in voice_ref. Editing runs in one text chunk.",
        "zh": "voice_ref 中被遮罩片段的结束帧（不含）。编辑在单个文本分块中执行。"
      },
      "max_tokens": {
        "en": "Maximum generated tokens per text chunk; each audio token represents 40 ms.",
        "zh": "每个文本分块生成的最大 token 数；每个音频 token 表示 40 ms。"
      },
      "min_tokens": {
        "en": "Minimum generated tokens before a stop token can be selected.",
        "zh": "可选择停止 token 前的最小生成 token 数。"
      },
      "temperature": {
        "en": "Sampling temperature; zero selects greedy decoding.",
        "zh": "采样温度；0 表示贪心解码。"
      },
      "top_p": {
        "en": "Nucleus sampling probability in (0, 1].",
        "zh": "核采样概率，范围 (0, 1]。"
      },
      "top_k": {
        "en": "Top-k sampling; -1 or zero disables filtering.",
        "zh": "top-k 采样；-1 或 0 关闭过滤。"
      },
      "seed": {
        "en": "Sampling and vocoder noise seed.",
        "zh": "采样与声码器噪声种子。"
      },
      "text_chunk_size": {
        "en": "Maximum Unicode codepoints per long-form text chunk.",
        "zh": "每个长文本分块的最大 Unicode 码点数。"
      },
      "text_chunk_mode": {
        "en": "Framework text chunking policy.",
        "zh": "框架文本分块策略。"
      },
      "silence_duration_sec": {
        "en": "Silence inserted between text chunks.",
        "zh": "文本分块之间插入的静音时长。"
      }
    }
  }
