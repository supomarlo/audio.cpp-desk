{
  "family": "pocket_tts",
  "i18n": {
    "description": {
      "en": "Kyutai 100M-parameter CPU-friendly TTS package set for real-time local synthesis and small-footprint voice cloning in English, French, German, Italian, Portuguese, and Spanish.",
      "zh": "Kyutai 100M 参数、面向 CPU 的轻量 TTS 包，支持英语、法语、德语、意大利语、葡萄牙语和西班牙语的本地实时合成与小体积音色克隆。"
    },
    "options": {
      "temperature": {
        "en": "Positive flow noise temperature; defaults to the model configuration. Captured during session preparation.",
        "zh": "正流噪声温度；默认为模型配置。在会议准备期间捕获。"
      },
      "seed": {
        "en": "Noise seed; omitted chooses a random seed. Captured during session preparation.",
        "zh": "噪声种子；省略选择随机种子。在会议准备期间捕获。"
      },
      "truncate_clone_audio": {
        "en": "Truncate voice clone audio. Captured during session preparation.",
        "zh": "截断语音克隆音频。在会议准备期间捕获。"
      },
      "frames_after_eos": {
        "en": "Extra frames after EOS; -1 uses the model-derived value.",
        "zh": "EOS 后额外保留的帧数；-1 使用模型推导值。"
      },
      "max_frames": {
        "en": "Maximum generated audio frames; zero estimates the cap from text length. Captured during session preparation.",
        "zh": "生成音频帧上限；0 表示按文本长度估算上限。在会话准备阶段捕获。"
      },
      "text_chunk_tokens": {
        "en": "Tokenizer tokens per text chunk; must be positive, default 50. Set during preparation and overridable per request.",
        "zh": "每个文本分块的 tokenizer token 数；必须为正，默认 50。准备阶段设置，可被单次请求覆盖。"
      },
      "noise_clamp": {
        "en": "Noise clamp; a negative value disables clamping. Captured during session preparation.",
        "zh": "噪声裁剪值；负值关闭裁剪。在会话准备阶段捕获。"
      },
      "eos_threshold": {
        "en": "EOS detection threshold. Captured during session preparation.",
        "zh": "EOS 检测阈值。在会话准备阶段捕获。"
      },
      "noise_file": {
        "en": "Precomputed noise schedule file. Captured during session preparation.",
        "zh": "预计算噪声序列文件。在会话准备阶段捕获。"
      },
      "voice_embedding_file": {
        "en": "Precomputed voice-state embedding path. Captured during session preparation.",
        "zh": "预计算 voice-state 嵌入路径。在会话准备阶段捕获。"
      },
      "text_chunk_size": {
        "en": "Optional per-request character chunk size; otherwise use sentence/token budgeting.",
        "zh": "可选的单请求字符分块大小；否则使用句子/token 预算。"
      },
      "export_voice_state_file": {
        "en": "Export the prepared voice state during session preparation.",
        "zh": "在会话准备阶段导出已准备的 voice state。"
      }
    }
  },
